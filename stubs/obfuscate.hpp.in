// Calypso loader - compile-time string encryption + call obfuscation
// Inspired by Obfusk8 (@x86byte) and ADVobfuscator (Sebastien Andrivet)
#pragma once
#include <cstdint>
#include <cstring>
#include <utility>

// Compile-time string encryption using __COUNTER__ + constexpr (ADVobfuscator pattern)
namespace calypso_obf {

constexpr uint32_t OBF_SEED = {{OBFUSCATION_SEED}}u;

constexpr uint32_t hash_ct(uint32_t counter, uint32_t line) {
    uint32_t h = OBF_SEED;
    h ^= counter * 2654435761u;
    h ^= line * 2246822519u;
    h = (h ^ (h >> 16)) * 0x45d9f3b;
    h = (h ^ (h >> 16)) * 0x45d9f3b;
    return h ^ (h >> 16);
}

constexpr char encrypt_char(char c, uint32_t key, size_t idx) {
    uint8_t k = static_cast<uint8_t>((key >> ((idx % 4) * 8)) & 0xFF);
    return static_cast<char>(static_cast<uint8_t>(c) ^ k);
}

template<size_t N, uint32_t Key>
struct ObfString {
    char data[N];

    constexpr ObfString(const char (&str)[N]) : data{} {
        for (size_t i = 0; i < N; i++)
            data[i] = encrypt_char(str[i], Key, i);
    }

    // Runtime decrypt into caller-provided buffer
    void decrypt(char* buf, size_t buf_size) const volatile {
        size_t len = (N < buf_size) ? N : buf_size;
        for (size_t i = 0; i < len; i++) {
            uint8_t k = static_cast<uint8_t>((Key >> ((i % 4) * 8)) & 0xFF);
            buf[i] = static_cast<char>(static_cast<uint8_t>(data[i]) ^ k);
        }
    }

    // Convenience: decrypt to stack buffer and return pointer
    // Caller is responsible for ensuring buf stays alive
    const char* get(char* buf, size_t buf_size) const volatile {
        decrypt(buf, buf_size);
        return buf;
    }
};

template<size_t N, uint32_t Key>
struct ObfWString {
    wchar_t data[N];

    constexpr ObfWString(const wchar_t (&str)[N]) : data{} {
        for (size_t i = 0; i < N; i++)
            data[i] = static_cast<wchar_t>(static_cast<uint16_t>(str[i]) ^
                       static_cast<uint16_t>((Key >> ((i % 2) * 16)) & 0xFFFF));
    }

    void decrypt(wchar_t* buf, size_t buf_count) const volatile {
        size_t len = (N < buf_count) ? N : buf_count;
        for (size_t i = 0; i < len; i++)
            buf[i] = static_cast<wchar_t>(static_cast<uint16_t>(data[i]) ^
                      static_cast<uint16_t>((Key >> ((i % 2) * 16)) & 0xFFFF));
    }

    const wchar_t* get(wchar_t* buf, size_t buf_count) const volatile {
        decrypt(buf, buf_count);
        return buf;
    }
};

} // namespace calypso_obf

#define OBF_KEY(c, l) (calypso_obf::hash_ct((c), (l)))

#define obf(s) []() -> const char* { \
    constexpr auto key = OBF_KEY(__COUNTER__, __LINE__); \
    static constexpr volatile calypso_obf::ObfString<sizeof(s), key> enc(s); \
    static char buf[sizeof(s)]; \
    enc.get(buf, sizeof(buf)); \
    return buf; \
}()

#define obf_wide(s) []() -> const wchar_t* { \
    constexpr auto key = OBF_KEY(__COUNTER__, __LINE__); \
    static constexpr volatile calypso_obf::ObfWString<sizeof(s)/sizeof(wchar_t), key> enc(s); \
    static wchar_t buf[sizeof(s)/sizeof(wchar_t)]; \
    enc.get(buf, sizeof(s)/sizeof(wchar_t)); \
    return buf; \
}()

// Obfuscated function call wrapper (ADVobfuscator-inspired trampoline)
template<typename Ret, typename... Args>
struct ObfCall {
    using FnPtr = Ret(__stdcall*)(Args...);
    volatile FnPtr ptr;

    ObfCall() : ptr(nullptr) {}
    explicit ObfCall(FnPtr p) : ptr(p) {}
    void set(FnPtr p) { ptr = p; }
    Ret operator()(Args... args) const { return ptr(args...); }
};

// DJB2 hash for API resolution
constexpr uint32_t djb2_hash(const char* str) {
    uint32_t hash = 5381;
    while (*str)
        hash = ((hash << 5) + hash) + static_cast<uint8_t>(*str++);
    return hash;
}
