// Encrypted payload
{{ENCRYPTED_PAYLOAD}}

{{#IF ENTROPY_REDUCE}}
// Entropy reduction mask
{{ENTROPY_MASK}}
{{#ENDIF}}

// Encryption key
{{KEY_DATA}}

static constexpr size_t ORIGINAL_SIZE = {{ORIGINAL_SIZE}};

{{#IF ENCODE_NONE}}
// No encoding - payload is raw bytes
{{#ENDIF}}
{{#IF ENCODE_BASE64}}
static const char encoded_payload[] = "{{ENCODED_PAYLOAD}}";
{{#ENDIF}}
{{#IF ENCODE_HEX}}
