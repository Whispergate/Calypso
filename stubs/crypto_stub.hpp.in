static const uint8_t Rcon_l[11] = {0x8d,0x01,0x02,0x04,0x08,0x10,0x20,0x40,0x80,0x1b,0x36};

static uint8_t xtime_l(uint8_t x) { return ((x<<1) ^ (((x>>7)&1)*0x1b)); }

static void KeyExpansion_l(uint8_t* RoundKey, const uint8_t* Key) {
    uint8_t tempa[4];
    unsigned i, k;
    for (i = 0; i < 8; ++i) {
        RoundKey[i*4+0]=Key[i*4+0]; RoundKey[i*4+1]=Key[i*4+1];
        RoundKey[i*4+2]=Key[i*4+2]; RoundKey[i*4+3]=Key[i*4+3];
    }
    for (i = 8; i < 4*(14+1); ++i) {
        k=(i-1)*4;
        tempa[0]=RoundKey[k+0]; tempa[1]=RoundKey[k+1];
        tempa[2]=RoundKey[k+2]; tempa[3]=RoundKey[k+3];
        if (i%8==0) {
            uint8_t u=tempa[0]; tempa[0]=tempa[1]; tempa[1]=tempa[2]; tempa[2]=tempa[3]; tempa[3]=u;
            tempa[0]=sbox_l[tempa[0]]; tempa[1]=sbox_l[tempa[1]];
            tempa[2]=sbox_l[tempa[2]]; tempa[3]=sbox_l[tempa[3]];
            tempa[0]^=Rcon_l[i/8];
        }
        if (i%8==4) {
            tempa[0]=sbox_l[tempa[0]]; tempa[1]=sbox_l[tempa[1]];
            tempa[2]=sbox_l[tempa[2]]; tempa[3]=sbox_l[tempa[3]];
        }
        k=(i-8)*4;
        RoundKey[i*4+0]=RoundKey[k+0]^tempa[0]; RoundKey[i*4+1]=RoundKey[k+1]^tempa[1];
        RoundKey[i*4+2]=RoundKey[k+2]^tempa[2]; RoundKey[i*4+3]=RoundKey[k+3]^tempa[3];
    }
}

typedef uint8_t state_l[4][4];

static void InvShiftRows_l(state_l* s) {
    uint8_t t;
    t=(*s)[3][1];(*s)[3][1]=(*s)[2][1];(*s)[2][1]=(*s)[1][1];(*s)[1][1]=(*s)[0][1];(*s)[0][1]=t;
    t=(*s)[0][2];(*s)[0][2]=(*s)[2][2];(*s)[2][2]=t; t=(*s)[1][2];(*s)[1][2]=(*s)[3][2];(*s)[3][2]=t;
    t=(*s)[0][3];(*s)[0][3]=(*s)[1][3];(*s)[1][3]=(*s)[2][3];(*s)[2][3]=(*s)[3][3];(*s)[3][3]=t;
}

static void InvSubBytes_l(state_l* s) {
    for(int i=0;i<4;i++) for(int j=0;j<4;j++) (*s)[j][i]=rsbox_l[(*s)[j][i]];
}

static void AddRoundKey_l(uint8_t r, state_l* s, const uint8_t* RK) {
    for(int i=0;i<4;i++) for(int j=0;j<4;j++) (*s)[i][j]^=RK[(r*16)+(i*4)+j];
}

static uint8_t Multiply_l(uint8_t x, uint8_t y) {
    return (((y&1)*x)^((y>>1&1)*xtime_l(x))^((y>>2&1)*xtime_l(xtime_l(x)))^
            ((y>>3&1)*xtime_l(xtime_l(xtime_l(x))))^((y>>4&1)*xtime_l(xtime_l(xtime_l(xtime_l(x))))));
}

static void InvMixColumns_l(state_l* s) {
    uint8_t a,b,c,d;
    for(int i=0;i<4;i++) {
        a=(*s)[i][0];b=(*s)[i][1];c=(*s)[i][2];d=(*s)[i][3];
        (*s)[i][0]=Multiply_l(a,0x0e)^Multiply_l(b,0x0b)^Multiply_l(c,0x0d)^Multiply_l(d,0x09);
        (*s)[i][1]=Multiply_l(a,0x09)^Multiply_l(b,0x0e)^Multiply_l(c,0x0b)^Multiply_l(d,0x0d);
        (*s)[i][2]=Multiply_l(a,0x0d)^Multiply_l(b,0x09)^Multiply_l(c,0x0e)^Multiply_l(d,0x0b);
        (*s)[i][3]=Multiply_l(a,0x0b)^Multiply_l(b,0x0d)^Multiply_l(c,0x09)^Multiply_l(d,0x0e);
    }
}

static void InvCipher_l(state_l* s, const uint8_t* RK) {
    AddRoundKey_l(14, s, RK);
    for(uint8_t r=13;;--r) {
        InvShiftRows_l(s); InvSubBytes_l(s); AddRoundKey_l(r, s, RK);
        if(r==0) break;
        InvMixColumns_l(s);
    }
}

static void AES_init_ctx_loader(AES_ctx_loader* ctx, const uint8_t* key) {
    KeyExpansion_l(ctx->RoundKey, key);
}
static void AES_init_ctx_iv_loader(AES_ctx_loader* ctx, const uint8_t* key, const uint8_t* iv) {
    KeyExpansion_l(ctx->RoundKey, key);
    memcpy(ctx->Iv, iv, 16);
}
static void AES_ECB_decrypt_loader(const AES_ctx_loader* ctx, uint8_t* buf) {
    InvCipher_l((state_l*)buf, ctx->RoundKey);
}
static void AES_CBC_decrypt_buffer_loader(AES_ctx_loader* ctx, uint8_t* buf, size_t length) {
    uint8_t storeIv[16];
    for(size_t i=0; i<length; i+=16) {
        memcpy(storeIv, buf+i, 16);
        InvCipher_l((state_l*)(buf+i), ctx->RoundKey);
        for(int j=0;j<16;j++) buf[i+j]^=ctx->Iv[j];
        memcpy(ctx->Iv, storeIv, 16);
    }
}
{{#ENDIF}}

// XOR decryption (works for both backends)
static void decrypt_xor(uint8_t* data, size_t data_len,
                         const uint8_t* key, size_t key_len) {
    for (size_t i = 0; i < data_len; i++)
        data[i] ^= key[i % key_len];
}

// RC4 stream cipher (symmetric - same operation for encrypt and decrypt)
static void decrypt_rc4(uint8_t* data, size_t data_len,
                         const uint8_t* key, size_t key_len) {
    uint8_t S[256];
    for (int i = 0; i < 256; i++) S[i] = static_cast<uint8_t>(i);
    uint8_t j = 0;
    for (int i = 0; i < 256; i++) {
        j = j + S[i] + key[i % key_len];
        uint8_t tmp = S[i]; S[i] = S[j]; S[j] = tmp;
    }
    uint8_t ii = 0, jj = 0;
    for (size_t k = 0; k < data_len; k++) {
        ii++;
        jj += S[ii];
        uint8_t tmp = S[ii]; S[ii] = S[jj]; S[jj] = tmp;
        data[k] ^= S[static_cast<uint8_t>(S[ii] + S[jj])];
    }
}

// PKCS7 unpadding
static size_t pkcs7_unpad(uint8_t* data, size_t len) {
    if (len == 0) return 0;
    uint8_t pad = data[len - 1];
    if (pad == 0 || pad > 16) return len;
    for (size_t i = len - pad; i < len; i++) {
        if (data[i] != pad) return len;
    }
    return len - pad;
}

// Unified decryption entry point
static bool decrypt_payload(uint8_t* data, size_t data_len,
                             const uint8_t* key, size_t key_len,
                             uint8_t* out, size_t* out_len) {
{{#IF CIPHER_XOR}}
    memcpy(out, data, data_len);
    decrypt_xor(out, data_len, key, key_len);
    *out_len = data_len;
    return true;
{{#ENDIF}}

{{#IF CIPHER_RC4}}
    memcpy(out, data, data_len);
    decrypt_rc4(out, data_len, key, key_len);
    *out_len = data_len;
    return true;
{{#ENDIF}}

{{#IF CIPHER_AES_ECB}}
{{#IF CRYPTO_CNG}}
    if (!decrypt_aes_ecb_cng(data, data_len, key, key_len, out, out_len))
        return false;
    *out_len = pkcs7_unpad(out, *out_len);
    return true;
{{#ENDIF}}
{{#IF CRYPTO_TINYAES}}
    memcpy(out, data, data_len);
    AES_ctx_loader ctx;
    AES_init_ctx_loader(&ctx, key);
    for (size_t i = 0; i < data_len; i += 16)
        AES_ECB_decrypt_loader(&ctx, out + i);
    *out_len = pkcs7_unpad(out, data_len);
    return true;
{{#ENDIF}}
{{#ENDIF}}

{{#IF CIPHER_AES_CBC}}
    // IV is first 16 bytes of data
    if (data_len < 16) return false;
    const uint8_t* iv = data;
    uint8_t* ciphertext = data + 16;
    size_t ct_len = data_len - 16;
{{#IF CRYPTO_CNG}}
    if (!decrypt_aes_cbc_cng(ciphertext, ct_len, key, key_len, iv, out, out_len))
        return false;
    *out_len = pkcs7_unpad(out, *out_len);
    return true;
{{#ENDIF}}
{{#IF CRYPTO_TINYAES}}
    memcpy(out, ciphertext, ct_len);
    AES_ctx_loader ctx;
    AES_init_ctx_iv_loader(&ctx, key, iv);
    AES_CBC_decrypt_buffer_loader(&ctx, out, ct_len);
    *out_len = pkcs7_unpad(out, ct_len);
    return true;
{{#ENDIF}}
{{#ENDIF}}
}
